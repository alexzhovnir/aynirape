---
import { getCollection } from "astro:content";

const DEFAULT_REGION = import.meta.env.DEFAULT_REGION ?? "gb";
export async function getStaticPaths() {
  const toSlug = (id: string) => id.replace(/\/index$/, "");
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: toSlug(post.id) } }));
}

const { slug } = Astro.params;
return Astro.redirect(`/${DEFAULT_REGION}/blog/${slug}`, 307);
---
