---
import Layout from "@layouts/Layout.astro";
import { getRegionParams } from "@lib/params/region-params";
import Breadcrumbs from "@components/Breadcrumbs.astro";

export const getStaticPaths = getRegionParams;

const { countryCode } = Astro.params;
---

<Layout
  title="Impressum - Legal Notice & Company Information"
  description="Official impressum, company details, representation, and legal disclosures for Ayni Rapé."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 text-[var(--color-text-primary)]">
    <!-- Breadcrumbs Nav -->
    <Breadcrumbs
      items={[
        { label: "Home", href: `/${countryCode}` },
        { label: "Impressum" }
      ]}
    />

    <!-- Hero Header Banner -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.28em] text-xs uppercase">
        TRANSPARENCY & LEGAL DISCLOSURE
      </span>
      <h1 class="mt-3 text-4xl sm:text-5xl font-serif-heading font-bold tracking-tight text-[var(--color-text-primary)] leading-tight">
        Impressum & <span class="italic font-normal text-[var(--color-accent-gold)]">Legal Information</span>
      </h1>
      <p class="mt-4 text-base md:text-lg text-[var(--color-text-secondary)] leading-relaxed">
        Required corporate details, regulatory compliance, and dispute resolution information for Ayni Rapé in the European Union.
      </p>
    </div>

    <!-- Quick Company Stats Cards -->
    <div class="grid sm:grid-cols-3 gap-6 mb-16">
      <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center text-xl shrink-0 border border-[var(--color-accent-gold)]/20">
          🏛️
        </div>
        <div>
          <strong class="block text-sm font-bold text-[var(--color-text-primary)]">Registered Business</strong>
          <span class="text-xs text-[var(--color-text-muted)]">European Union</span>
        </div>
      </div>

      <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center text-xl shrink-0 border border-[var(--color-accent-gold)]/20">
          ✉️
        </div>
        <div>
          <strong class="block text-sm font-bold text-[var(--color-text-primary)]">Direct Inquiry</strong>
          <span class="text-xs text-[var(--color-text-muted)]">info@aynirape.com</span>
        </div>
      </div>

      <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center text-xl shrink-0 border border-[var(--color-accent-gold)]/20">
          ⚖️
        </div>
        <div>
          <strong class="block text-sm font-bold text-[var(--color-text-primary)]">ODR Compliant</strong>
          <span class="text-xs text-[var(--color-text-muted)]">EU Consumer Protection</span>
        </div>
      </div>
    </div>

    <!-- Structured Content Grid (2 Columns) -->
    <div class="grid lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Company & Representation Card (7 Cols) -->
      <div class="lg:col-span-7 bg-[var(--color-bg-surface-elevated)] p-8 sm:p-10 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm space-y-8">
        <div>
          <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.2em] text-xs uppercase block mb-1">BUSINESS DETAILS</span>
          <h2 class="text-2xl font-serif-heading font-bold text-[var(--color-text-primary)]">
            Provider Information according to § 5 DDG
          </h2>
        </div>

        <div class="space-y-6 text-sm text-[var(--color-text-secondary)] leading-relaxed">
          <div class="p-6 rounded-2xl bg-[var(--color-bg-surface)] border border-[var(--color-border-subtle)] space-y-3">
            <h3 class="text-base font-bold text-[var(--color-text-primary)] font-serif-heading">Company Name & Brand</h3>
            <p>
              <strong class="text-[var(--color-text-primary)] text-base">Ayni Râpé Co.</strong><br/>
              Sacred Botanical Medicine & Shamanic Artifacts
            </p>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div class="p-5 rounded-2xl bg-[var(--color-bg-surface)] border border-[var(--color-border-subtle)]">
              <span class="text-xs font-bold text-[var(--color-accent-gold)] uppercase tracking-wider block mb-1">Authorized Representative</span>
              <p class="text-sm font-bold text-[var(--color-text-primary)]">Alex Zhovnir</p>
              <span class="text-xs text-[var(--color-text-muted)]">Founder & Managing Facilitator</span>
            </div>

            <div class="p-5 rounded-2xl bg-[var(--color-bg-surface)] border border-[var(--color-border-subtle)]">
              <span class="text-xs font-bold text-[var(--color-accent-gold)] uppercase tracking-wider block mb-1">Electronic Contact</span>
              <p class="text-sm font-bold text-[var(--color-text-primary)]">info@aynirape.com</p>
              <span class="text-xs text-[var(--color-text-muted)]">24/7 Support Desk</span>
            </div>
          </div>

          <div>
            <h3 class="text-base font-bold text-[var(--color-text-primary)] font-serif-heading mb-2">Copyright & Intellectual Property</h3>
            <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
              All contents, photographies, designs, and text descriptions published on this website are protected under international copyright laws. Any unauthorized reproduction, copying, or redistribution requires prior written authorization from Ayni Rapé Co.
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Legal Disclaimers & Dispute Resolution (5 Cols) -->
      <div class="lg:col-span-5 space-y-8">
        <!-- ODR Dispute Resolution Card -->
        <div class="bg-[var(--color-bg-surface-elevated)] p-8 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm space-y-4 hover:border-[var(--color-accent-gold)] transition-colors">
          <div class="w-10 h-10 rounded-2xl bg-[var(--color-accent-gold)]/15 text-[var(--color-accent-gold)] flex items-center justify-center text-lg border border-[var(--color-accent-gold)]/30">
            ⚖️
          </div>
          <h2 class="text-xl font-serif-heading font-bold text-[var(--color-text-primary)]">
            Online Dispute Resolution (ODR)
          </h2>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            The European Commission provides a platform for online dispute resolution, accessible via the official link below:
          </p>
          <a
            href="https://ec.europa.eu/consumers/odr"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-xs font-bold text-[var(--color-accent-gold)] hover:underline p-3 rounded-xl bg-[var(--color-bg-surface)] border border-[var(--color-border-subtle)] w-full justify-between"
          >
            <span>ec.europa.eu/consumers/odr</span>
            <span>&rarr;</span>
          </a>
          <p class="text-[10px] text-[var(--color-text-muted)] leading-relaxed pt-2">
            * We are neither obligated nor committed to participate in dispute resolution proceedings before a consumer arbitration board.
          </p>
        </div>

        <!-- Botanical Disclaimer Card -->
        <div class="bg-[var(--color-bg-surface-elevated)] p-8 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm space-y-3">
          <div class="flex items-center gap-2 text-xs font-bold text-[var(--color-accent-gold)] uppercase tracking-wider">
            <span>🌿</span>
            <span>Botanical Sample Notice</span>
          </div>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            Our products are supplied exclusively as authentic ethnographic botanical specimens, incense resins, and ceremonial artifacts. No therapeutic or medicinal cure claims are made.
          </p>
        </div>
      </div>
    </div>

    <!-- Contact CTA Banner -->
    <div class="mt-16 bg-gradient-to-r from-[var(--color-bg-surface-elevated)] via-[var(--color-bg-surface)] to-[var(--color-bg-surface-elevated)] p-8 rounded-3xl border border-[var(--color-border-subtle)] text-center shadow-md">
      <h2 class="text-2xl font-serif-heading font-bold text-[var(--color-text-primary)] mb-2">
        Have Questions About Our Legal Disclosures?
      </h2>
      <p class="text-xs text-[var(--color-text-secondary)] max-w-lg mx-auto mb-6">
        Our support team is available to provide any required documentation or clarification.
      </p>
      <a
        href={`/${countryCode}/contact`}
        class="inline-block px-8 py-3.5 bg-[var(--color-accent-gold)] hover:bg-[var(--color-accent-gold-hover)] text-stone-950 font-bold text-xs uppercase tracking-wider rounded-full transition-all duration-300 shadow-md cursor-pointer"
      >
        Contact Customer Support &rarr;
      </a>
    </div>
  </div>
</Layout>
