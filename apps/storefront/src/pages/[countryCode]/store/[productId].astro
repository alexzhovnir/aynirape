---
import Layout from "@layouts/Layout.astro";
import { retrieveProduct, listProducts } from "@lib/data/products";
import { getRegion } from "@lib/data/regions";
import { getProductParams } from "@lib/params/product-params";
import { getProductPrice } from "@lib/utils/get-product-price";
import { useTranslations } from "@lib/i18n/utils";
import SilverTepiLanding from "@modules/products/components/SilverTepiLanding.astro";
import UniversalProductLanding from "@modules/products/components/UniversalProductLanding.astro";

export const getStaticPaths = getProductParams;

const { countryCode, productId } = Astro.params;

if (!countryCode || !productId) {
  return Astro.redirect("/not-found");
}

const t = useTranslations(countryCode!);

const region = await getRegion(countryCode);

if (!region) {
  return Astro.redirect("/not-found");
}

let product: Awaited<ReturnType<typeof retrieveProduct>> | undefined;
let relatedProducts: Awaited<ReturnType<typeof listProducts>> = [];
let allProducts: Awaited<ReturnType<typeof listProducts>> = [];
let error: Error | undefined;

try {
  product = await retrieveProduct(productId, region.id);
  allProducts = await listProducts(region.id);
  relatedProducts = allProducts.filter((p) => p.id !== productId);
} catch (e) {
  error = e instanceof Error ? e : new Error("Unknown error");
  console.error(error);
}

const {
  title,
  description,
  images,
  thumbnail,
  variants,
} = product ?? {};

const { cheapestPrice } = getProductPrice({
  productVariants: variants ?? [],
});

const descriptionParagraphs = (description ?? "").split(/\r?\n\n/).filter(Boolean);
const shortSellingDescription = descriptionParagraphs[0] || description || "";

const schemaData = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": title,
  "image": images && images.length > 0 ? images.map((img) => img.url) : (thumbnail ? [thumbnail] : []),
  "description": description,
  "sku": variants?.[0]?.sku || productId,
  "brand": {
    "@type": "Brand",
    "name": "Ayni Rapé"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": cheapestPrice?.currency_code?.toUpperCase() || "EUR",
    "lowPrice": cheapestPrice?.calculated_amount,
    "highPrice": cheapestPrice?.original_amount || cheapestPrice?.calculated_amount,
    "offerCount": variants?.length || 1,
    "availability": variants?.some((v) => (v.inventory_quantity ?? 1) > 0)
      ? "https://schema.org/InStock"
      : "https://schema.org/OutOfStock",
    "url": Astro.url.href,
  },
};

const isSilverTepiDoubleCobra = product?.handle === "silver-tepi-double-cobra" || productId === "silver-tepi-double-cobra";
---

<Layout
  title={title}
  description={shortSellingDescription || `Shop ${title} at Ayni Rapé.`}
  image={images?.[0]?.url}
  type="product"
>
  <!-- SEO JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  {
    product && (
      isSilverTepiDoubleCobra ? (
        <SilverTepiLanding
          product={product}
          region={region}
          cheapestPrice={cheapestPrice}
          t={t}
          countryCode={countryCode!}
          relatedProducts={relatedProducts}
        />
      ) : (
        <UniversalProductLanding
          product={product}
          region={region}
          cheapestPrice={cheapestPrice}
          t={t}
          countryCode={countryCode!}
          relatedProducts={relatedProducts}
        />
      )
    )
  }
</Layout>
