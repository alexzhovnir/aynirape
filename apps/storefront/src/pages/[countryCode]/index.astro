---
import Layout from "@layouts/Layout.astro";
import { getRegion } from "@lib/data/regions";
import { listProducts, listCategories } from "@lib/data/products";
import { getRegionParams } from "@lib/params/region-params";
import ProductPreview from "@modules/products/components/product-preview/ProductPreview.astro";
import CeremonyGuide from "@components/CeremonyGuide.astro";
import { FaqAccordion } from "@components/FaqAccordion";
import { getCollection } from "astro:content";
import { useTranslations } from "@lib/i18n/utils";

export const getStaticPaths = getRegionParams;

const { countryCode } = Astro.params;

const region = await getRegion(countryCode);

if (!region) {
  return Astro.redirect("/not-found");
}

let products: Awaited<ReturnType<typeof listProducts>> = [];
let categories: Awaited<ReturnType<typeof listCategories>> = [];
let dbReviews: any[] = [];
let error: Error | undefined;

const t = useTranslations(countryCode);

try {
  products = await listProducts(region.id);
  categories = await listCategories();
  
  // Fetch real verified user reviews from backend
  const backendUrl = import.meta.env.PUBLIC_MEDUSA_BACKEND_URL || 'http://localhost:9009';
  const res = await fetch(`${backendUrl}/store/feedback`);
  if (res.ok) {
    const data = await res.json();
    dbReviews = data.feedbacks || [];
  }
} catch (e) {
  error = e instanceof Error ? e : new Error("Unknown error");
  console.error(error);
}

// Bestsellers list matching old site & screenshots
const bestsellerHandles = ['nukini-sansara', 'huni-kuin', 'yawanawa-tsunu', 'spiritual-cleanse', 'kuripe-wolf-sawo', 'kuripe-colibri-teak', 'agua-de-florida', 'palo-santo'];
const bestsellers = products.filter(p => bestsellerHandles.includes(p.handle));
const bestsellersList = bestsellers.length > 0 ? bestsellers : products;

// Category cards setup (All 5 categories with fallback images)
const rapeProduct = products.find(p => p.handle === 'nukini-sansara' || p.categories?.some(c => c.handle?.includes('rape')));
const tepiProduct = products.find(p => p.handle === 'kuripe-colibri-teak' || p.categories?.some(c => c.handle?.includes('tepi')));
const aromaticsProduct = products.find(p => p.handle === 'agua-de-florida' || p.categories?.some(c => c.handle?.includes('aromatics')));
const supplementsProduct = products.find(p => p.categories?.some(c => c.handle?.includes('supplements'))) || products[3];
const ornamentsProduct = products.find(p => p.categories?.some(c => c.handle?.includes('ornament'))) || products[4];

const featuredCategories = [
  {
    name: "Rapé",
    desc: t("home.hero.description"),
    href: `/${countryCode}/store/category/rapé`,
    imageUrl: rapeProduct?.images?.[0]?.url || rapeProduct?.thumbnail
  },
  {
    name: "Tepi and Kuripe",
    desc: "Handcrafted traditional applicators made from sacred Sawo wood, Teak, and Sterling Silver.",
    href: `/${countryCode}/store/category/tepi-and-kuripe`,
    imageUrl: tepiProduct?.images?.[0]?.url || tepiProduct?.thumbnail
  },
  {
    name: "Aromatics",
    desc: "Purifying Palo Santo, Agua de Florida, and ritual incense for cleansing.",
    href: `/${countryCode}/store/category/aromatics`,
    imageUrl: aromaticsProduct?.images?.[0]?.url || aromaticsProduct?.thumbnail
  },
  {
    name: "Supplements",
    desc: "Natural Amazonian botanical tinctures and herbal wellness preparations.",
    href: `/${countryCode}/store/category/supplements`,
    imageUrl: supplementsProduct?.images?.[0]?.url || supplementsProduct?.thumbnail
  },
  {
    name: "Ornaments and decoration",
    desc: "Tribal beaded necklaces, feather art, and ceremonial decorations.",
    href: `/${countryCode}/store/category/ornaments-and-decoration`,
    imageUrl: ornamentsProduct?.images?.[0]?.url || ornamentsProduct?.thumbnail
  }
];

// Combine DB reviews with fallbacks if empty
const fallbackReviews = [
  {
    id: "fb_1",
    author_name: "Alexander M.",
    product_title: "Nukini Sansara",
    rating: 5,
    comment: "Extraordinary quality! The grounding and heart-opening alignment of the Nukini blend is unmatched. Fast delivery to Germany.",
    created_at: "2026-03-15"
  },
  {
    id: "fb_2",
    author_name: "Elena R.",
    product_title: "Kuripe Colibri Teak",
    rating: 5,
    comment: "The hand-carved teak Kuripe is a masterpiece. Perfect blow angle, smooth finish, and powerful ceremonial energy.",
    created_at: "2026-03-10"
  },
  {
    id: "fb_3",
    author_name: "Marcus K.",
    product_title: "Agua de Florida",
    rating: 5,
    comment: "Authentic Peruvian scent for space clearing before meditation. 100% genuine and packed securely.",
    created_at: "2026-02-28"
  }
];

const reviewsList = dbReviews.length > 0 ? dbReviews : fallbackReviews;

const fmtReviewDate = (dateStr: string) => {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit", year: "numeric" });
  } catch {
    return dateStr;
  }
};

// Blog Posts setup
const blogPosts = (
  await getCollection(
    "blog",
    ({ data }) => data.language === "en" && !data.draft,
  )
).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime(),
).slice(0, 3);

const fmtBlogDate = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit", year: "numeric" });

const slugOf = (id: string) => id.replace(/\/index$/, "");

const heroImages = [
  "/images/blog/rape/nukini-1504.23abece79ac5bad050fdc8779f1c5b53.webp",
  "/images/blog/rape/huni-kuin-1404.c8a1014cf868eec84ebc440a5301bfcd.webp",
  "/images/blog/rape/yavanawa-1504.aa960525f69629782ccf9275b27102c6.webp",
  "/images/blog/rape/spiritual-cleanse-1504.acee2e127356f3967513c528b9ee0ad6.webp",
  "/images/blog/kolibri-teak.c6c0e21a20358358ba4cfc9a759bfa19.webp",
  "/images/blog/kuripe-wolf-sawo.02682445cd108ab57e6f69e9a16ce418.webp"
];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${Astro.site ?? Astro.url.origin}#organization`,
      "name": "Ayni Rapé",
      "description": "Ayni Rapé offers ethically sourced, premium Amazonian shamanic supplies, Rapé blends, Tepi & Kuripe applicators, and sacred aromatics.",
      "url": Astro.site ?? Astro.url.origin,
      "logo": {
        "@type": "ImageObject",
        "url": new URL("/favicon.svg", Astro.site ?? Astro.url.origin).href
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "ayni.rapeh@gmail.com",
        "contactType": "customer support"
      },
      "sameAs": [
        "https://www.instagram.com/ayni_rapeh"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${Astro.site ?? Astro.url.origin}#website`,
      "url": Astro.site ?? Astro.url.origin,
      "name": "Ayni Rapé",
      "description": "Ethically sourced, premium Amazonian shamanic supplies, Rapé blends, Tepi & Kuripe applicators, and sacred aromatics.",
      "publisher": {
        "@id": `${Astro.site ?? Astro.url.origin}#organization`
      }
    }
  ]
};
---

<Layout
  title={t("seo.home.title")}
  description={t("seo.home.description")}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <!-- Hero Section -->
  <section class="relative bg-stone-900 border-b border-[var(--color-border-subtle)] overflow-hidden py-16 md:py-24 px-6 md:px-12 shadow-sm min-h-[500px] flex items-center justify-start w-full">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/home_hero_premium.jpg" 
        alt="Amazonian Rainforest Background" 
        class="w-full h-full object-cover object-center opacity-80"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-stone-950/90 via-stone-950/60 to-stone-950/20 pointer-events-none"></div>
    </div>

    <div class="max-w-7xl mx-auto w-full relative z-10 grid md:grid-cols-[1.2fr_0.8fr] gap-12 items-center">
      <!-- Left Column: Content -->
      <div class="relative z-10 w-full flex flex-col gap-6">
          <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.2em] text-xs uppercase drop-shadow-md">{t("home.hero.subtitle")}</span>
          <h1 class="text-4xl md:text-5xl lg:text-7xl font-serif-heading font-bold tracking-tight leading-tight text-white drop-shadow-lg">
            {t("home.hero.title_part1")} <br/><span class="italic font-normal text-[var(--color-accent-gold)]">{t("home.hero.title_part2_italic")}</span> {t("home.hero.title_part3")}
          </h1>
          <p class="text-stone-200 text-base md:text-lg leading-relaxed max-w-xl drop-shadow-md">
            {t("home.hero.description")}
          </p>
          <div class="flex flex-wrap gap-4 mt-4">
            <a
              href={`/${countryCode}/store`}
              class="px-8 py-4 bg-[var(--color-accent-gold)] hover:bg-[#A88349] text-stone-950 font-bold text-xs uppercase tracking-wider rounded-full transition-all duration-300 shadow-md cursor-pointer border border-transparent"
            >
              {t("home.hero.cta_store")}
            </a>
            <a
              href={`/blog`}
              class="px-8 py-4 border border-stone-300 text-stone-100 hover:border-white hover:text-white font-bold text-xs uppercase tracking-wider rounded-full transition-all duration-300 cursor-pointer bg-stone-950/30 backdrop-blur-sm"
            >
              {t("home.hero.cta_blog")}
            </a>
          </div>
        </div>

        <!-- Right Column: Auto Carousel -->
        <div class="relative w-64 h-64 sm:w-80 sm:h-80 lg:w-96 lg:h-96 mx-auto flex items-center justify-center shrink-0">
          <div class="absolute inset-0 bg-[var(--color-accent-gold)]/20 rounded-full blur-3xl pointer-events-none scale-110"></div>
          
          <div class="relative w-full h-full rounded-full overflow-hidden border-2 border-white/20 shadow-2xl bg-[var(--color-bg-surface)] flex items-center justify-center backdrop-blur-sm">
            {heroImages.map((src, i) => (
              <img
                src={src}
                alt="Sacred Amazonian Shamanic Supplies"
                class={`hero-slide-img absolute inset-0 w-full h-full object-cover rounded-full transition-opacity duration-1000 ease-in-out ${i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
              />
            ))}
          </div>

          <div class="absolute -bottom-4 bg-stone-900/90 backdrop-blur-md px-4 py-1.5 rounded-full border border-white/20 shadow-lg z-20 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-[10px] uppercase font-bold tracking-widest text-[var(--color-accent-gold)]">{t("home.hero.badge")}</span>
          </div>
        </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <!-- Value Proposition / Trust Bar -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-4 my-8">
      <div class="flex items-center gap-3 bg-[var(--color-bg-surface-elevated)] p-4 rounded-2xl border border-[var(--color-border-subtle)]">
        <span class="text-2xl">🌿</span>
        <div class="text-xs">
          <strong class="block text-[var(--color-text-primary)]">{t("home.trust.ethical.title")}</strong>
          <span class="text-[var(--color-text-muted)]">{t("home.trust.ethical.desc")}</span>
        </div>
      </div>
      <div class="flex items-center gap-3 bg-[var(--color-bg-surface-elevated)] p-4 rounded-2xl border border-[var(--color-border-subtle)]">
        <span class="text-2xl">🪵</span>
        <div class="text-xs">
          <strong class="block text-[var(--color-text-primary)]">{t("home.trust.authentic.title")}</strong>
          <span class="text-[var(--color-text-muted)]">{t("home.trust.authentic.desc")}</span>
        </div>
      </div>
      <div class="flex items-center gap-3 bg-[var(--color-bg-surface-elevated)] p-4 rounded-2xl border border-[var(--color-border-subtle)]">
        <span class="text-2xl">🌱</span>
        <div class="text-xs">
          <strong class="block text-[var(--color-text-primary)]">{t("home.trust.pledge.title")}</strong>
          <span class="text-[var(--color-text-muted)]">{t("home.trust.pledge.desc")}</span>
        </div>
      </div>
      <div class="flex items-center gap-3 bg-[var(--color-bg-surface-elevated)] p-4 rounded-2xl border border-[var(--color-border-subtle)]">
        <span class="text-2xl">📦</span>
        <div class="text-xs">
          <strong class="block text-[var(--color-text-primary)]">{t("home.trust.delivery.title")}</strong>
          <span class="text-[var(--color-text-muted)]">{t("home.trust.delivery.desc")}</span>
        </div>
      </div>
    </section>
  </div>

  <!-- Categories Carousel Section (Full Bleed) -->
  <section class="py-12 overflow-hidden w-full">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-end justify-between gap-8 mb-10">
      <div>
        <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.2em] text-xs uppercase">{t("home.categories.subtitle")}</span>
        <h2 class="text-3xl font-serif-heading font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl mt-2">{t("home.categories.title")}</h2>
      </div>

      <div class="flex items-center gap-2">
        <button id="cat-slider-prev" class="w-10 h-10 rounded-full border border-[var(--color-border-subtle)] bg-[var(--color-bg-surface-elevated)] text-[var(--color-text-primary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] flex items-center justify-center cursor-pointer transition-colors shadow-sm" aria-label="Previous categories">&larr;</button>
        <button id="cat-slider-next" class="w-10 h-10 rounded-full border border-[var(--color-border-subtle)] bg-[var(--color-bg-surface-elevated)] text-[var(--color-text-primary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] flex items-center justify-center cursor-pointer transition-colors shadow-sm" aria-label="Next categories">&rarr;</button>
      </div>
    </div>

    <div id="cat-slider" class="flex gap-4 overflow-x-auto scrollbar-none pb-8 pt-4 scroll-smooth snap-x snap-mandatory px-4 sm:px-6 lg:px-8 xl:px-[calc((100vw-80rem)/2+2rem)]">
      {featuredCategories.map((cat) => (
        <div class="w-[240px] sm:w-[260px] md:w-[280px] snap-start shrink-0">
          <a
            href={cat.href}
            class="group block bg-[var(--color-bg-surface-elevated)] border border-[var(--color-border-subtle)] rounded-3xl p-6 transition-all duration-300 hover:border-[var(--color-accent-gold)] shadow-sm hover:shadow-xl flex flex-col h-full justify-between"
          >
            <div>
              <div class="w-full aspect-[4/3] rounded-2xl overflow-hidden mb-6 bg-[var(--color-bg-surface)] border border-[var(--color-border-subtle)]">
                {cat.imageUrl ? (
                  <img
                    src={cat.imageUrl}
                    alt={cat.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-4xl text-[var(--color-accent-gold)]">
                    🌿
                  </div>
                )}
              </div>
              <h3 class="text-xl font-serif-heading font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-gold)] transition-colors mb-2">
                {cat.name}
              </h3>
              <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed line-clamp-2 mb-4">
                {cat.desc}
              </p>
            </div>

            <div class="flex items-center text-xs font-bold text-[var(--color-accent-gold)] group-hover:translate-x-1 transition-transform">
              <span>{t("home.categories.explore")}</span>
              <span class="ml-1">&rarr;</span>
            </div>
          </a>
        </div>
      ))}
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <!-- Sacred Ceremony Guide Section -->
    <section class="py-6 bg-[var(--color-bg-surface-elevated)] border border-[var(--color-border-subtle)] rounded-3xl my-8">
      <CeremonyGuide />
    </section>
  </div>

  <!-- Bestsellers Carousel Section (Full Bleed) -->
  {bestsellersList.length > 0 && (
    <section class="py-12 overflow-hidden w-full">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-end justify-between gap-8 mb-10">
        <div>
          <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.2em] text-xs uppercase">{t("home.bestsellers.subtitle")}</span>
          <h2 class="text-3xl font-serif-heading font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl mt-2">{t("home.bestsellers.title")}</h2>
        </div>
        
        <div class="flex items-center gap-2">
          <button id="best-slider-prev" class="w-10 h-10 rounded-full border border-[var(--color-border-subtle)] bg-[var(--color-bg-surface-elevated)] text-[var(--color-text-primary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] flex items-center justify-center cursor-pointer transition-colors shadow-sm" aria-label="Previous bestsellers">&larr;</button>
          <button id="best-slider-next" class="w-10 h-10 rounded-full border border-[var(--color-border-subtle)] bg-[var(--color-bg-surface-elevated)] text-[var(--color-text-primary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] flex items-center justify-center cursor-pointer transition-colors shadow-sm" aria-label="Next bestsellers">&rarr;</button>
        </div>
      </div>

      <div id="bestsellers-slider" class="flex gap-6 overflow-x-auto scrollbar-none pb-8 pt-4 scroll-smooth snap-x snap-mandatory px-4 sm:px-6 lg:px-8 xl:px-[calc((100vw-80rem)/2+2rem)]">
        {bestsellersList.map((product) => (
          <div class="w-[260px] sm:w-[280px] md:w-[300px] shrink-0 snap-start">
            <ProductPreview
              id={product.id}
              variants={product.variants ?? []}
              thumbnailUrl={product.thumbnail ?? undefined}
              imageUrl={product.images?.[0]?.url}
              title={product.title}
            />
          </div>
        ))}
      </div>
    </section>
  )}

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <!-- Real Customer Reviews Section -->
    <section class="py-12 bg-[var(--color-bg-surface-elevated)] border border-[var(--color-border-subtle)] rounded-3xl my-8 px-6 md:px-12">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.2em] text-xs uppercase">{t("home.testimonials.subtitle")}</span>
        <h2 class="text-3xl font-serif-heading font-bold text-[var(--color-text-primary)] mt-2">{t("home.testimonials.title")}</h2>
        <p class="text-xs text-[var(--color-text-secondary)] mt-2">{t("home.testimonials.desc")}</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {reviewsList.slice(0, 3).map((review) => (
          <div class="bg-[var(--color-bg-surface)] p-6 rounded-2xl border border-[var(--color-border-subtle)] shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex text-[var(--color-accent-gold)] text-sm">
                  {"★".repeat(review.rating || 5)}
                </div>
                <span class="text-[10px] text-[var(--color-text-muted)]">{fmtReviewDate(review.created_at)}</span>
              </div>
              <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed italic mb-4">
                "{review.comment}"
              </p>
            </div>
            <div class="pt-3 border-t border-[var(--color-border-subtle)] flex items-center justify-between text-xs">
              <strong class="text-[var(--color-text-primary)] font-serif-heading">{review.author_name || t("home.testimonials.verified")}</strong>
              {review.product_title && (
                <span class="text-[10px] text-[var(--color-accent-gold)] font-medium truncate max-w-[120px]">
                  {review.product_title}
                </span>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-12 max-w-4xl mx-auto">
      <div class="mb-8 text-left">
        <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.2em] text-xs uppercase">{t("home.faq.subtitle")}</span>
        <h2 class="text-4xl font-serif-heading font-extrabold tracking-tight text-[var(--color-text-primary)] mt-2">{t("home.faq.title")}</h2>
      </div>
      <FaqAccordion client:visible />
    </section>

    <!-- Latest Journal Posts Section -->
    {blogPosts.length > 0 && (
      <section class="py-12">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-12">
          <div>
            <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.2em] text-xs uppercase">{t("home.journal.subtitle")}</span>
            <h2 class="text-3xl font-serif-heading font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl mt-2">{t("home.journal.title")}</h2>
          </div>
          <a
            href="/blog"
            class="text-xs font-bold text-[var(--color-accent-gold)] hover:underline flex items-center gap-1 uppercase tracking-wider"
          >
            <span>{t("home.journal.read_all")}</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {blogPosts.map((post) => (
            <a
              href={`/blog/${slugOf(post.id)}`}
              class="group bg-[var(--color-bg-surface-elevated)] border border-[var(--color-border-subtle)] rounded-3xl overflow-hidden transition-all duration-300 hover:border-[var(--color-accent-gold)] shadow-sm hover:shadow-xl flex flex-col justify-between"
            >
              <div>
                <div class="w-full aspect-[16/10] overflow-hidden bg-[var(--color-bg-surface)] relative">
                  {post.data.coverImage ? (
                    <>
                      <img
                        src={post.data.coverImage}
                        alt={post.data.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                      />
                      <div class="w-full h-full items-center justify-center text-3xl text-[var(--color-accent-gold)]" style="display:none">
                        📜
                      </div>
                    </>
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-3xl text-[var(--color-accent-gold)]">
                      📜
                    </div>
                  )}
                </div>
                <div class="p-6">
                  <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider text-[var(--color-accent-gold)] mb-2">
                    <span>{post.data.category}</span>
                    <span>&bull;</span>
                    <time class="text-[var(--color-text-muted)]">{fmtBlogDate(post.data.publishedDate)}</time>
                  </div>
                  <h3 class="text-lg font-serif-heading font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-gold)] transition-colors leading-snug mb-2">
                    {post.data.title}
                  </h3>
                  <p class="text-xs text-[var(--color-text-secondary)] line-clamp-2 leading-relaxed">
                    {post.data.excerpt}
                  </p>
                </div>
              </div>
              <div class="px-6 pb-6 pt-0 text-xs font-bold text-[var(--color-accent-gold)] flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                <span>{t("home.journal.read_story")}</span>
                <span>&rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    // Hero carousel animation logic
    const slides = document.querySelectorAll('.hero-slide-img');
    if (slides.length > 1) {
      let current = 0;
      setInterval(() => {
        slides[current].classList.remove('opacity-100', 'z-10');
        slides[current].classList.add('opacity-0', 'z-0');
        current = (current + 1) % slides.length;
        slides[current].classList.remove('opacity-0', 'z-0');
        slides[current].classList.add('opacity-100', 'z-10');
      }, 3500);
    }

    // Categories slider logic
    const catSlider = document.getElementById('categories-slider');
    const catNextBtn = document.getElementById('cat-slider-next');
    const catPrevBtn = document.getElementById('cat-slider-prev');
    if (catSlider) {
      catNextBtn?.addEventListener('click', () => catSlider.scrollLeft += 340);
      catPrevBtn?.addEventListener('click', () => catSlider.scrollLeft -= 340);
    }

    // Bestsellers slider logic
    const bestSlider = document.getElementById('bestsellers-slider');
    const bestNextBtn = document.getElementById('best-slider-next');
    const bestPrevBtn = document.getElementById('best-slider-prev');
    if (bestSlider) {
      bestNextBtn?.addEventListener('click', () => bestSlider.scrollLeft += 320);
      bestPrevBtn?.addEventListener('click', () => bestSlider.scrollLeft -= 320);
    }
  });
</script>
