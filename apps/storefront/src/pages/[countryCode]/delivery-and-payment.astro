---
import Layout from "@layouts/Layout.astro";
import { getRegionParams } from "@lib/params/region-params";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { useTranslations } from "@lib/i18n/utils";

export const getStaticPaths = getRegionParams;

const { countryCode } = Astro.params;

const t = useTranslations(countryCode);
---

<Layout
  title={t("seo.delivery.title")}
  description={t("seo.delivery.description")}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 text-[var(--color-text-primary)]">
    <!-- Breadcrumbs Nav -->
    <Breadcrumbs
      items={[
        { label: "Home", href: `/${countryCode}` },
        { label: "Delivery & Payment" }
      ]}
    />

    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.28em] text-xs uppercase">
        {t("delivery.hero.subtitle")}
      </span>
      <h1 class="mt-3 text-4xl sm:text-5xl font-serif-heading font-bold tracking-tight text-[var(--color-text-primary)] leading-tight">
        {t("delivery.hero.title")} <span class="italic font-normal text-[var(--color-accent-gold)]">{t("delivery.hero.title_italic")}</span>
      </h1>
      <p class="mt-4 text-base md:text-lg text-[var(--color-text-secondary)] leading-relaxed">
        {t("delivery.hero.desc")}
      </p>
    </div>

    <!-- Main Content Container -->
    <div class="space-y-16">
      <!-- Section 1: Delivery Options -->
      <div>
        <div class="mb-8">
          <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.2em] text-xs uppercase">{t("delivery.shipping.subtitle")}</span>
          <h2 class="text-2xl sm:text-3xl font-serif-heading font-bold text-[var(--color-text-primary)] mt-1">{t("delivery.shipping.title")}</h2>
          <p class="text-xs text-[var(--color-text-secondary)] mt-1">{t("delivery.shipping.desc")}</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Standard Shipping Card -->
          <div class="bg-[var(--color-bg-surface-elevated)] p-8 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm hover:border-[var(--color-accent-gold)] transition-colors flex flex-col justify-between gap-6">
            <div>
              <div class="flex justify-between items-center mb-4">
                <span class="text-3xl">📦</span>
                <span class="bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-[var(--color-accent-gold)]/20">
                  RELIABLE
                </span>
              </div>
              <h3 class="text-xl font-serif-heading font-bold text-[var(--color-text-primary)] mb-2">Standard Postal Shipping</h3>
              <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed mb-6">
                Delivery through national postal services across the EU. Discreet and safe.
              </p>
              
              <div class="space-y-2 border-t border-[var(--color-border-subtle)] pt-4 text-xs">
                <div class="flex justify-between">
                  <span class="text-[var(--color-text-muted)]">Delivery Time:</span>
                  <strong class="text-[var(--color-text-primary)]">5 – 7 business days</strong>
                </div>
                <div class="flex justify-between">
                  <span class="text-[var(--color-text-muted)]">Shipping Fee:</span>
                  <strong class="text-[var(--color-text-primary)]">€5.00</strong>
                </div>
                <div class="flex justify-between">
                  <span class="text-[var(--color-text-muted)]">Free Shipping:</span>
                  <strong class="text-[var(--color-accent-gold)]">Free for orders over €150</strong>
                </div>
              </div>
            </div>
          </div>

          <!-- DHL Express Shipping Card -->
          <div class="bg-[var(--color-bg-surface-elevated)] p-8 rounded-3xl border-2 border-[var(--color-accent-gold)] shadow-md flex flex-col justify-between gap-6 relative overflow-hidden">
            <div class="absolute top-0 right-0 bg-[var(--color-accent-gold)] text-stone-950 text-[10px] font-bold uppercase tracking-widest px-4 py-1 rounded-bl-2xl">
              RECOMMENDED
            </div>

            <div>
              <div class="flex justify-between items-center mb-4">
                <span class="text-3xl">⚡</span>
              </div>
              <h3 class="text-xl font-serif-heading font-bold text-[var(--color-text-primary)] mb-2">DHL Express Courier</h3>
              <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed mb-6">
                Premium priority courier service with live step-by-step tracking to your door.
              </p>
              
              <div class="space-y-2 border-t border-[var(--color-border-subtle)] pt-4 text-xs">
                <div class="flex justify-between">
                  <span class="text-[var(--color-text-muted)]">Delivery Time:</span>
                  <strong class="text-[var(--color-text-primary)]">3 – 5 business days</strong>
                </div>
                <div class="flex justify-between">
                  <span class="text-[var(--color-text-muted)]">Shipping Fee:</span>
                  <strong class="text-[var(--color-text-primary)]">€12.00</strong>
                </div>
                <div class="flex justify-between">
                  <span class="text-[var(--color-text-muted)]">Tracking:</span>
                  <strong class="text-emerald-500">Live SMS & Email Alerts</strong>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 2: Payment Methods -->
      <div>
        <div class="mb-8">
          <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.2em] text-xs uppercase">{t("delivery.payment.subtitle")}</span>
          <h2 class="text-2xl sm:text-3xl font-serif-heading font-bold text-[var(--color-text-primary)] mt-1">{t("delivery.payment.title")}</h2>
          <p class="text-xs text-[var(--color-text-secondary)] mt-1">{t("delivery.payment.desc")}</p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] text-center flex flex-col items-center gap-3 shadow-sm hover:border-[var(--color-accent-gold)] transition-colors">
            <span class="text-3xl">💳</span>
            <div>
              <strong class="block text-sm font-bold text-[var(--color-text-primary)]">Cards</strong>
              <span class="text-[10px] text-[var(--color-text-muted)]">Visa, Mastercard, Amex</span>
            </div>
          </div>

          <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] text-center flex flex-col items-center gap-3 shadow-sm hover:border-[var(--color-accent-gold)] transition-colors">
            <span class="text-3xl">🅿️</span>
            <div>
              <strong class="block text-sm font-bold text-[var(--color-text-primary)]">PayPal</strong>
              <span class="text-[10px] text-[var(--color-text-muted)]">1-Click Checkout</span>
            </div>
          </div>

          <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] text-center flex flex-col items-center gap-3 shadow-sm hover:border-[var(--color-accent-gold)] transition-colors">
            <span class="text-3xl">📱</span>
            <div>
              <strong class="block text-sm font-bold text-[var(--color-text-primary)]">Apple / Google Pay</strong>
              <span class="text-[10px] text-[var(--color-text-muted)]">Mobile Wallet</span>
            </div>
          </div>

          <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] text-center flex flex-col items-center gap-3 shadow-sm hover:border-[var(--color-accent-gold)] transition-colors">
            <span class="text-3xl">🏛️</span>
            <div>
              <strong class="block text-sm font-bold text-[var(--color-text-primary)]">Bank Transfer</strong>
              <span class="text-[10px] text-[var(--color-text-muted)]">SEPA Transfer</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 3: Climate & CO2 Removal Box -->
      <div class="bg-gradient-to-r from-[var(--color-bg-surface-elevated)] via-[var(--color-bg-surface)] to-[var(--color-bg-surface-elevated)] p-8 sm:p-10 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm flex flex-col md:flex-row items-center gap-8 justify-between">
        <div class="flex items-center gap-6">
          <div class="w-16 h-16 rounded-full bg-[var(--color-accent-gold)]/15 flex items-center justify-center text-3xl shrink-0 border border-[var(--color-accent-gold)]/30">
            🌱
          </div>
          <div>
            <h3 class="text-xl font-serif-heading font-bold text-[var(--color-text-primary)] mb-1">
              1% CO₂ Climate Removal Initiative
            </h3>
            <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed max-w-xl">
              At Ayni Rapé, <strong>1% of your purchase</strong> is directly donated to support atmospheric carbon removal initiatives and Amazonian rainforest restoration.
            </p>
          </div>
        </div>
        <a
          href={`/${countryCode}/store`}
          class="px-6 py-3 bg-[var(--color-accent-gold)] text-stone-950 font-bold rounded-full text-xs uppercase tracking-wider hover:bg-[var(--color-accent-gold-hover)] transition-colors shrink-0 shadow-sm"
        >
          Shop Responsibly
        </a>
      </div>

      <!-- Section 4: Returns & Replacements -->
      <div class="bg-[var(--color-bg-surface-elevated)] p-8 sm:p-10 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm space-y-4">
        <div class="flex items-center gap-3">
          <span class="text-2xl">🛡️</span>
          <h2 class="text-xl font-serif-heading font-bold text-[var(--color-text-primary)]">
            Returns & Replacements Policy
          </h2>
        </div>
        <div class="space-y-3 text-xs text-[var(--color-text-secondary)] leading-relaxed max-w-3xl">
          <p>
            Returns are accepted for products in the categories <strong><a href={`/${countryCode}/store/category/kuripes-tepis`} class="hover:text-[var(--color-accent-gold)] transition-colors underline decoration-[var(--color-border-subtle)] underline-offset-4">"Tepi and Kuripe"</a></strong> and <strong>"Ornaments and decoration"</strong> in the event of damage having occurred during shipping or manufacturing defects.
          </p>
          <p>
            If you receive a damaged item, please email us at <a href="mailto:info@aynirape.com" class="text-[var(--color-accent-gold)] font-bold hover:underline">info@aynirape.com</a> within 7 days of delivery with photos of the issue. Our support team will resolve it promptly with a replacement or full refund.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
