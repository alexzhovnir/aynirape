---
import Layout from "@layouts/Layout.astro";
import { getRegionParams } from "@lib/params/region-params";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import Icon from "@components/icons/Icon.astro";
import { useTranslations } from "@lib/i18n/utils";

export const getStaticPaths = getRegionParams;

const { countryCode } = Astro.params;

const t = useTranslations(countryCode);
---

<Layout
  title={t("seo.about.title")}
  description={t("seo.about.description")}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 text-[var(--color-text-primary)]">
    <!-- Breadcrumbs Nav -->
    <Breadcrumbs
      items={[
        { label: t("common.home") || "Home", href: `/${countryCode}` },
        { label: t("common.about_us") || "About Us" }
      ]}
    />

    <!-- Top Hero Banner -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.28em] text-xs uppercase">
        {t("about_page.subtitle")}
      </span>
      <h1 class="mt-3 text-4xl sm:text-5xl font-serif-heading font-bold tracking-tight text-[var(--color-text-primary)] leading-tight">
        {t("about_page.title")} <span class="italic font-normal text-[var(--color-accent-gold)]">{t("about_page.title_italic")}</span>
      </h1>
      <p class="mt-4 text-base md:text-lg text-[var(--color-text-secondary)] leading-relaxed">
        {t("about_page.desc")}
      </p>
    </div>

    <!-- Main 2-Column Hero / Story Section -->
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left Column: Image Gallery & Stats Badge -->
      <div class="relative flex justify-center">
        <div class="absolute inset-0 bg-[var(--color-accent-gold)]/10 rounded-3xl blur-3xl scale-95 -z-10"></div>
        <div class="flex flex-col gap-4 max-w-lg lg:max-w-none w-full">
          <div class="relative rounded-3xl overflow-hidden border border-[var(--color-border-subtle)] shadow-2xl bg-[var(--color-bg-surface-elevated)] group">
            <img
              src="/images/about-story.jpg"
              alt="Sacred Rapé Preparation & Ancestral Traditions"
              class="w-full h-[480px] lg:h-[580px] object-cover object-bottom group-hover:scale-105 transition-transform duration-700 ease-out"
            />
          </div>

          <!-- Stats Grid Below Image -->
          <div class="p-6 rounded-2xl bg-[var(--color-bg-surface-elevated)] border border-[var(--color-border-subtle)] shadow-lg grid grid-cols-3 gap-4 text-center">
            <div>
              <span class="block text-xl font-bold font-serif-heading text-[var(--color-accent-gold)]">5</span>
              <span class="text-[10px] text-[var(--color-text-muted)] uppercase tracking-wider font-semibold">{t("about_page.stats.tribes")}</span>
            </div>
            <div>
              <span class="block text-xl font-bold font-serif-heading text-[var(--color-accent-gold)]">100%</span>
              <span class="text-[10px] text-[var(--color-text-muted)] uppercase tracking-wider font-semibold">{t("about_page.stats.trade")}</span>
            </div>
            <div>
              <span class="block text-xl font-bold font-serif-heading text-[var(--color-accent-gold)]">1% CO₂</span>
              <span class="text-[10px] text-[var(--color-text-muted)] uppercase tracking-wider font-semibold">{t("about_page.stats.pledge")}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Rich Expanded Text -->
      <div class="flex flex-col gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-[0.28em] text-[var(--color-accent-gold)] block mb-1">{t("about_page.story.subtitle")}</span>
          <h2 class="text-3xl sm:text-4xl font-serif-heading font-bold tracking-tight text-[var(--color-text-primary)] leading-tight">
            {t("about_page.story.title")}
          </h2>
        </div>

        <div class="space-y-4 text-sm md:text-base leading-relaxed text-[var(--color-text-secondary)]">
          <p>{t("about_page.story.p1")}</p>
          <p>{t("about_page.story.p2")}</p>
          <p>{t("about_page.story.p3")}</p>
          <p>{t("about_page.story.p4")}</p>
        </div>
      </div>
    </div>

    <!-- Section 2: Indigenous Tribes We Partner With -->
    <div class="mt-24 pt-16 border-t border-[var(--color-border-subtle)]">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.2em] text-xs uppercase">{t("about_page.tribes.subtitle")}</span>
        <h2 class="text-3xl font-serif-heading font-bold text-[var(--color-text-primary)] mt-2">{t("about_page.tribes.title")}</h2>
        <p class="text-xs text-[var(--color-text-secondary)] mt-2">{t("about_page.tribes.desc")}</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm hover:border-[var(--color-accent-gold)] transition-all duration-300">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center mb-3">
            <Icon name="compass" class="w-5 h-5" />
          </div>
          <h3 class="font-serif-heading font-bold text-[var(--color-text-primary)] text-lg mb-1">Huni Kuin (Kaxinawá)</h3>
          <span class="text-[10px] font-bold text-[var(--color-accent-gold)] uppercase tracking-wider block mb-2">Acre, Brazil</span>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            {t("about_page.tribes.huni_kuin")}
          </p>
        </div>

        <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm hover:border-[var(--color-accent-gold)] transition-all duration-300">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center mb-3">
            <Icon name="flame" class="w-5 h-5" />
          </div>
          <h3 class="font-serif-heading font-bold text-[var(--color-text-primary)] text-lg mb-1">Yawanawá</h3>
          <span class="text-[10px] font-bold text-[var(--color-accent-gold)] uppercase tracking-wider block mb-2">Gregório River, Brazil</span>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            {t("about_page.tribes.yawanawa")}
          </p>
        </div>

        <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm hover:border-[var(--color-accent-gold)] transition-all duration-300">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center mb-3">
            <Icon name="sparkles" class="w-5 h-5" />
          </div>
          <h3 class="font-serif-heading font-bold text-[var(--color-text-primary)] text-lg mb-1">Nukini</h3>
          <span class="text-[10px] font-bold text-[var(--color-accent-gold)] uppercase tracking-wider block mb-2">Juruá Valley, Brazil</span>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            {t("about_page.tribes.nukini")}
          </p>
        </div>

        <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm hover:border-[var(--color-accent-gold)] transition-all duration-300">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center mb-3">
            <Icon name="leaf" class="w-5 h-5" />
          </div>
          <h3 class="font-serif-heading font-bold text-[var(--color-text-primary)] text-lg mb-1">Katukina</h3>
          <span class="text-[10px] font-bold text-[var(--color-accent-gold)] uppercase tracking-wider block mb-2">Panoan Nation, Brazil</span>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            {t("about_page.tribes.katukina")}
          </p>
        </div>

        <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm hover:border-[var(--color-accent-gold)] transition-all duration-300">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center mb-3">
            <Icon name="flower-2" class="w-5 h-5" />
          </div>
          <h3 class="font-serif-heading font-bold text-[var(--color-text-primary)] text-lg mb-1">Shanenawa</h3>
          <span class="text-[10px] font-bold text-[var(--color-accent-gold)] uppercase tracking-wider block mb-2">Feijó, Brazil</span>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            {t("about_page.tribes.shanenawa")}
          </p>
        </div>

        <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm hover:border-[var(--color-accent-gold)] transition-all duration-300 flex flex-col justify-center text-center">
          <div class="w-10 h-10 rounded-xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center mx-auto mb-3">
            <Icon name="heart-handshake" class="w-5 h-5" />
          </div>
          <h3 class="font-serif-heading font-bold text-[var(--color-text-primary)] text-base mb-1">{t("about_page.tribes.fair_trade_title")}</h3>
          <p class="text-xs text-[var(--color-text-muted)]">
            {t("about_page.tribes.fair_trade_desc")}
          </p>
        </div>
      </div>
    </div>

    <!-- Section 3: Our History Timeline -->
    <div class="mt-24 pt-16 border-t border-[var(--color-border-subtle)]">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.2em] text-xs uppercase">{t("about_page.timeline.subtitle")}</span>
        <h2 class="text-3xl font-serif-heading font-bold text-[var(--color-text-primary)] mt-2">{t("about_page.timeline.title")}</h2>
      </div>

      <div class="grid md:grid-cols-4 gap-6 relative">
        <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm relative">
          <span class="text-xs font-bold text-[var(--color-accent-gold)] block mb-2">{t("about_page.timeline.t1_tag")}</span>
          <h3 class="font-serif-heading font-bold text-[var(--color-text-primary)] text-base mb-2">{t("about_page.timeline.t1_title")}</h3>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            {t("about_page.timeline.t1_desc")}
          </p>
        </div>

        <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm relative">
          <span class="text-xs font-bold text-[var(--color-accent-gold)] block mb-2">{t("about_page.timeline.t2_tag")}</span>
          <h3 class="font-serif-heading font-bold text-[var(--color-text-primary)] text-base mb-2">{t("about_page.timeline.t2_title")}</h3>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            {t("about_page.timeline.t2_desc")}
          </p>
        </div>

        <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm relative">
          <span class="text-xs font-bold text-[var(--color-accent-gold)] block mb-2">{t("about_page.timeline.t3_tag")}</span>
          <h3 class="font-serif-heading font-bold text-[var(--color-text-primary)] text-base mb-2">{t("about_page.timeline.t3_title")}</h3>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            {t("about_page.timeline.t3_desc")}
          </p>
        </div>

        <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm relative">
          <span class="text-xs font-bold text-[var(--color-accent-gold)] block mb-2">{t("about_page.timeline.t4_tag")}</span>
          <h3 class="font-serif-heading font-bold text-[var(--color-text-primary)] text-base mb-2">{t("about_page.timeline.t4_title")}</h3>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            {t("about_page.timeline.t4_desc")}
          </p>
        </div>
      </div>
    </div>

    <!-- Section 4: 4 Key Core Principles Cards -->
    <div class="mt-24 pt-16 border-t border-[var(--color-border-subtle)]">
      <div class="text-center mb-12">
        <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.2em] text-xs uppercase">{t("about_page.pillars.subtitle")}</span>
        <h2 class="text-3xl font-serif-heading font-bold text-[var(--color-text-primary)] mt-2">{t("about_page.pillars.title")}</h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm hover:border-[var(--color-accent-gold)] transition-colors flex flex-col items-start">
          <div class="w-12 h-12 rounded-2xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center mb-4 border border-[var(--color-accent-gold)]/20">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
            </svg>
          </div>
          <h3 class="font-serif-heading font-bold text-[var(--color-text-primary)] text-lg mb-2">{t("about_page.pillars.p1_title")}</h3>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            {t("about_page.pillars.p1_desc")}
          </p>
        </div>

        <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm hover:border-[var(--color-accent-gold)] transition-colors flex flex-col items-start">
          <div class="w-12 h-12 rounded-2xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center mb-4 border border-[var(--color-accent-gold)]/20">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21 8.25 8.25 0 0 1 6.038 7.047 8.287 8.287 0 0 0 9 9.601a8.983 8.983 0 0 1 3.361-6.867 8.21 8.21 0 0 0 3 2.48Z" />
            </svg>
          </div>
          <h3 class="font-serif-heading font-bold text-[var(--color-text-primary)] text-lg mb-2">{t("about_page.pillars.p2_title")}</h3>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            {t("about_page.pillars.p2_desc")}
          </p>
        </div>

        <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm hover:border-[var(--color-accent-gold)] transition-colors flex flex-col items-start">
          <div class="w-12 h-12 rounded-2xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center mb-4 border border-[var(--color-accent-gold)]/20">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 21l8.982-1.173L17 15l-7.187.904zM21 9.813L15.904 9 15 17.982 21 17l-.904-7.187z" />
            </svg>
          </div>
          <h3 class="font-serif-heading font-bold text-[var(--color-text-primary)] text-lg mb-2">{t("about_page.pillars.p3_title")}</h3>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            {t("about_page.pillars.p3_desc")}
          </p>
        </div>

        <div class="bg-[var(--color-bg-surface-elevated)] p-6 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm hover:border-[var(--color-accent-gold)] transition-colors flex flex-col items-start">
          <div class="w-12 h-12 rounded-2xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center mb-4 border border-[var(--color-accent-gold)]/20">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 0 0 .495-7.467 5.99 5.99 0 0 0-1.925-3.546 5.974 5.974 0 0 0-2.133-1A3.75 3.75 0 0 0 4.5 12a3.75 3.75 0 0 0 3.75 3.75h3.75Z" />
            </svg>
          </div>
          <h3 class="font-serif-heading font-bold text-[var(--color-text-primary)] text-lg mb-2">{t("about_page.pillars.p4_title")}</h3>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            {t("about_page.pillars.p4_desc")}
          </p>
        </div>
      </div>
    </div>

    <!-- Call to Action Banner -->
    <div class="mt-20 bg-gradient-to-r from-[var(--color-bg-surface-elevated)] via-[var(--color-bg-surface)] to-[var(--color-bg-surface-elevated)] p-10 rounded-3xl border border-[var(--color-border-subtle)] text-center shadow-md">
      <h2 class="text-3xl font-serif-heading font-bold text-[var(--color-text-primary)] mb-3">
        {t("about_page.cta.title")}
      </h2>
      <p class="text-xs text-[var(--color-text-secondary)] max-w-xl mx-auto mb-6 leading-relaxed">
        {t("about_page.cta.desc")}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={`/${countryCode}/store`}
          class="px-8 py-4 bg-[var(--color-accent-gold)] hover:bg-[var(--color-accent-gold-hover)] text-stone-950 font-bold text-xs uppercase tracking-wider rounded-full transition-all duration-300 shadow-md cursor-pointer"
        >
          {t("about_page.cta.view_catalogue")}
        </a>
        <a
          href={`/${countryCode}/blog`}
          class="px-8 py-4 border border-[var(--color-border-subtle)] text-[var(--color-text-primary)] hover:border-[var(--color-accent-gold)] hover:text-[var(--color-accent-gold)] font-bold text-xs uppercase tracking-wider rounded-full transition-all duration-300 cursor-pointer bg-[var(--color-bg-surface)]"
        >
          {t("about_page.cta.read_journal")}
        </a>
      </div>
    </div>
  </div>
</Layout>
