---
import Layout from "@layouts/Layout.astro";
import { listRegions } from "@lib/data/regions";
import { getRegionParams } from "@lib/params/region-params";
import type { RegionCountry } from "@modules/checkout/components/AddressFields";
import { CheckoutPage } from "@modules/checkout/components/CheckoutPage";
import InPostGeoWidget from "@modules/checkout/components/InPostGeoWidget.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { useTranslations } from "@lib/i18n/utils";

export const getStaticPaths = getRegionParams;

const { countryCode } = Astro.params;

if (!countryCode) {
  return Astro.redirect("/not-found");
}

let countries: RegionCountry[] = [];

try {
  const regions = await listRegions();
  const region = regions.find((r) =>
    r.countries?.some(
      (c) => c.iso_2?.toLowerCase() === countryCode.toLowerCase()
    )
  );

  if (region?.countries) {
    countries = region.countries
      .filter((c): c is typeof c & { iso_2: string } => !!c.iso_2)
      .sort((a, b) =>
        (a.display_name ?? a.name ?? "").localeCompare(
          b.display_name ?? b.name ?? ""
        )
      )
      .map((c) => ({
        iso_2: c.iso_2,
        display_name: c.display_name,
        name: c.name,
      }));
  }
} catch (err) {
  console.error("Failed to fetch region countries for checkout:", err);
}

const t = useTranslations(countryCode);
---

<Layout title={t("seo.checkout.title")} description={t("seo.checkout.description")} noindex>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 text-[var(--color-text-primary)]">
    <Breadcrumbs
      items={[
        { label: String(t("nav.home")), href: `/${countryCode}` },
        { label: String(t("seo.cart.title")), href: `/${countryCode}/cart` },
        { label: String(t("seo.checkout.title")) }
      ]}
    />
    <CheckoutPage client:only="react" countryCode={countryCode} countries={countries} />
    <InPostGeoWidget />
  </div>
</Layout>
