---
import Layout from "@layouts/Layout.astro";
import { getRegionParams } from "@lib/params/region-params";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { useTranslations } from "@lib/i18n/utils";

export const getStaticPaths = getRegionParams;

const { countryCode } = Astro.params;

const t = useTranslations(countryCode);
---

<Layout
  title={t("seo.terms.title")}
  description={t("seo.terms.description")}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 text-[var(--color-text-primary)]">
    <!-- Breadcrumbs Nav -->
    <Breadcrumbs
      items={[
        { label: t("common.home") || "Home", href: `/${countryCode}` },
        { label: t("common.terms_and_conditions") || "Terms & Conditions" }
      ]}
    />

    <div class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.28em] text-[var(--color-accent-gold)]">
        {t("terms_page.subtitle")}
      </p>
      <h1 class="mt-4 text-4xl font-serif-heading font-bold tracking-tight text-[var(--color-text-primary)]">
        {t("terms_page.title")}
      </h1>
      <p class="mt-2 text-sm text-[var(--color-text-secondary)]">
        {t("terms_page.desc")}
      </p>

      <div class="mt-8 space-y-6 text-base leading-8 text-[var(--color-text-secondary)]">
        <p>{t("terms_page.p1")}</p>
        <p>{t("terms_page.p2")}</p>
        <p>
          {t("terms_page.p3")} <a href={`/${countryCode}/contact`} class="text-[var(--color-accent-gold)] hover:underline font-medium">{t("common.contact_us")}</a>.
        </p>

        <!-- Botanical Specimen Disclaimer Box -->
        <div class="p-6 rounded-2xl bg-[var(--color-bg-surface-elevated)] border border-[var(--color-border-subtle)] mt-8">
          <strong class="block text-sm font-bold text-[var(--color-accent-gold)] mb-2 font-serif-heading">
            {t("terms_page.botanical_notice_title")}
          </strong>
          <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
            {t("terms_page.botanical_notice_desc")}
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
