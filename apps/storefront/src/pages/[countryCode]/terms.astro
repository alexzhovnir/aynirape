---
import Layout from "@layouts/Layout.astro";
import { getRegionParams } from "@lib/params/region-params";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { useTranslations } from "@lib/i18n/utils";

export const getStaticPaths = getRegionParams;

const { countryCode } = Astro.params;

const t = useTranslations(countryCode);
---

<Layout
  title={t("seo.terms.title")}
  description={t("seo.terms.description")}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 text-[var(--color-text-primary)]">
    <!-- Breadcrumbs Nav -->
    <Breadcrumbs
      items={[
        { label: "Home", href: `/${countryCode}` },
        { label: "Terms & Conditions" }
      ]}
    />

    <div class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.28em] text-[var(--color-accent-gold)]">
        Terms
      </p>
      <h1 class="mt-4 text-4xl font-serif-heading font-bold tracking-tight text-[var(--color-text-primary)]">
        Terms & Conditions
      </h1>
      <div class="mt-8 space-y-6 text-base leading-8 text-[var(--color-text-secondary)]">
        <p>
          This storefront provides authentic shamanic supplies and sacred botanical remedies from Amazonian indigenous communities. Product, pricing, and checkout behavior depend on the connected Medusa backend configuration.
        </p>
        <p>
          Orders placed on our platform are processed securely. Please ensure that shipping information provided during checkout is accurate for timely European delivery.
        </p>
        <p>
          For inquiries regarding custom orders or initiation ceremonies, please reach out via our <a href={`/${countryCode}/contact`} class="text-[var(--color-accent-gold)] hover:underline font-medium">Contact page</a>.
        </p>
      </div>
    </div>
  </div>
</Layout>
