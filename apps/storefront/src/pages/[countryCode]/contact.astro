---
import Layout from "@layouts/Layout.astro";
import { getRegionParams } from "@lib/params/region-params";
import Breadcrumbs from "@components/Breadcrumbs.astro";

export const getStaticPaths = getRegionParams;

const { countryCode } = Astro.params;
---

<Layout
  title="Contact Us - Customer Care & Inquiries"
  description="Get in touch with the Ayni Rapé team for questions about our shamanic products, order support, or custom ceremony supplies."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 text-[var(--color-text-primary)]">
    <!-- Breadcrumbs Nav -->
    <Breadcrumbs
      items={[
        { label: "Home", href: `/${countryCode}` },
        { label: "Contact Us" }
      ]}
    />

    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-[var(--color-accent-gold)] font-bold tracking-[0.28em] text-xs uppercase">
        CUSTOMER CARE & SUPPORT
      </span>
      <h1 class="mt-3 text-4xl sm:text-5xl font-serif-heading font-bold tracking-tight text-[var(--color-text-primary)] leading-tight">
        Get in Touch <span class="italic font-normal text-[var(--color-accent-gold)]">With Us</span>
      </h1>
      <p class="mt-4 text-base md:text-lg text-[var(--color-text-secondary)] leading-relaxed">
        Have questions about our Amazonian blends, shipping times, or application guidance? We are here to assist your journey.
      </p>
    </div>

    <!-- Main 2-Column Grid -->
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Quick Contact Info Cards (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <!-- Email Support Card -->
        <div class="bg-[var(--color-bg-surface-elevated)] p-8 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm hover:border-[var(--color-accent-gold)] transition-colors">
          <div class="w-12 h-12 rounded-2xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center text-xl mb-4 border border-[var(--color-accent-gold)]/20">
            ✉️
          </div>
          <h2 class="text-xl font-serif-heading font-bold text-[var(--color-text-primary)] mb-1">Direct Email</h2>
          <p class="text-xs text-[var(--color-text-secondary)] mb-4 leading-relaxed">
            Our support team usually responds within 24 business hours.
          </p>
          <a
            href="mailto:info@aynirape.com"
            class="text-sm font-bold text-[var(--color-accent-gold)] hover:underline inline-flex items-center gap-2"
          >
            info@aynirape.com &rarr;
          </a>
        </div>

        <!-- Social Channels Card -->
        <div class="bg-[var(--color-bg-surface-elevated)] p-8 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm hover:border-[var(--color-accent-gold)] transition-colors">
          <div class="w-12 h-12 rounded-2xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center text-xl mb-4 border border-[var(--color-accent-gold)]/20">
            📷
          </div>
          <h2 class="text-xl font-serif-heading font-bold text-[var(--color-text-primary)] mb-1">Instagram Community</h2>
          <p class="text-xs text-[var(--color-text-secondary)] mb-4 leading-relaxed">
            Follow our ceremonial updates, tribal origins, and educational posts.
          </p>
          <a
            href="https://www.instagram.com/ayni_rapeh"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-bold text-[var(--color-accent-gold)] hover:underline inline-flex items-center gap-2"
          >
            @ayni_rapeh &rarr;
          </a>
        </div>

        <!-- Custom Orders & Wholesale Card -->
        <div class="bg-[var(--color-bg-surface-elevated)] p-8 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm">
          <div class="w-12 h-12 rounded-2xl bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] flex items-center justify-center text-xl mb-4 border border-[var(--color-accent-gold)]/20">
            🤝
          </div>
          <h2 class="text-xl font-serif-heading font-bold text-[var(--color-text-primary)] mb-1">Wholesale & Custom Orders</h2>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            Are you a facilitator, store owner, or space holder looking for custom quantities or silver Tepi creations? Write to us for special terms.
          </p>
        </div>
      </div>

      <!-- Right Column: Interactive Form (7 Cols) -->
      <div class="lg:col-span-7 bg-[var(--color-bg-surface-elevated)] p-8 sm:p-10 lg:p-12 rounded-3xl border border-[var(--color-border-subtle)] shadow-sm">
        <h2 class="text-2xl font-serif-heading font-bold text-[var(--color-text-primary)] mb-2">
          Send Us a Message
        </h2>
        <p class="text-xs text-[var(--color-text-secondary)] mb-8 leading-relaxed">
          Fill out the form below and we will get back to you as soon as possible.
        </p>

        <form id="contact-form" class="space-y-6">
          <div class="grid sm:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
                Your Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="e.g. Maria Santos"
                class="w-full px-4 py-3 bg-[var(--color-bg-surface)] border border-[var(--color-border-subtle)] rounded-2xl text-sm text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-accent-gold)] transition-colors placeholder:text-[var(--color-text-muted)]"
              />
            </div>

            <div class="space-y-2">
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
                Email Address <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="name@example.com"
                class="w-full px-4 py-3 bg-[var(--color-bg-surface)] border border-[var(--color-border-subtle)] rounded-2xl text-sm text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-accent-gold)] transition-colors placeholder:text-[var(--color-text-muted)]"
              />
            </div>
          </div>

          <div class="space-y-2">
            <label for="subject" class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
              Topic / Inquiry
            </label>
            <select
              id="subject"
              name="subject"
              class="w-full px-4 py-3 bg-[var(--color-bg-surface)] border border-[var(--color-border-subtle)] rounded-2xl text-sm text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-accent-gold)] transition-colors cursor-pointer"
            >
              <option value="General Question">General Question</option>
              <option value="Order Status & Delivery">Order Status & Delivery</option>
              <option value="Product Advice & Guidance">Product Advice & Guidance</option>
              <option value="Wholesale & Facilitator Inquiry">Wholesale & Facilitator Inquiry</option>
            </select>
          </div>

          <div class="space-y-2">
            <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
              Your Message <span class="text-red-500">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="How can we help you today?"
              class="w-full px-4 py-3 bg-[var(--color-bg-surface)] border border-[var(--color-border-subtle)] rounded-2xl text-sm text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-accent-gold)] transition-colors placeholder:text-[var(--color-text-muted)] resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="btn-submit-contact"
            class="w-full py-4 bg-[var(--color-accent-gold)] hover:bg-[var(--color-accent-gold-hover)] text-stone-950 font-bold text-xs uppercase tracking-wider rounded-full transition-all duration-300 shadow-md cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Send Message</span>
            <span>&rarr;</span>
          </button>
        </form>

        <div id="contact-success-msg" class="hidden mt-6 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-500 text-xs font-medium text-center">
          Thank you! Your message has been sent successfully. We will reply via email shortly.
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form');
    const successMsg = document.getElementById('contact-success-msg');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (successMsg) {
        successMsg.classList.remove('hidden');
        form.reset();
        setTimeout(() => {
          successMsg.classList.add('hidden');
        }, 5000);
      }
    });
  });
</script>
