---
import { getRegion } from "@lib/data/regions";
import { CartSidebar } from "@modules/layout/components/CartSidebar";
import Footer from "@modules/layout/components/Footer.astro";
import { Nav } from "@modules/layout/components/Nav";
import "@styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getLangFromRegion } from "@lib/i18n/config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "product";
  noindex?: boolean;
}

const SITE_NAME = "Ayni Rapé";
const DEFAULT_DESCRIPTION =
  "Ayni Rapé offers ethically sourced, premium Amazonian shamanic supplies, Rapé blends, Tepi & Kuripe applicators, and sacred aromatics.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image,
  type = "website",
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin
);

const { countryCode } = Astro.params;

if (!countryCode) {
  return Astro.redirect("/not-found");
}

const region = await getRegion(countryCode);
const regionId = region?.id || null;

const lang = getLangFromRegion(countryCode);

const siteOrigin = Astro.site ? Astro.site.origin : Astro.url.origin;
const pathSuffix = Astro.url.pathname.replace(new RegExp(`^/${countryCode}(/|$)`), "/");
const cleanSuffix = pathSuffix.endsWith("/") && pathSuffix !== "/" ? pathSuffix.slice(0, -1) : pathSuffix;
const relativeSuffix = cleanSuffix === "/" ? "" : cleanSuffix;

const hreflangs = [
  { lang: "x-default", href: `${siteOrigin}/us${relativeSuffix}` },
  { lang: "en", href: `${siteOrigin}/us${relativeSuffix}` },
  { lang: "en-US", href: `${siteOrigin}/us${relativeSuffix}` },
  { lang: "en-GB", href: `${siteOrigin}/gb${relativeSuffix}` },
  { lang: "de", href: `${siteOrigin}/de${relativeSuffix}` },
  { lang: "de-DE", href: `${siteOrigin}/de${relativeSuffix}` },
  { lang: "de-AT", href: `${siteOrigin}/at${relativeSuffix}` },
  { lang: "de-CH", href: `${siteOrigin}/ch${relativeSuffix}` },
  { lang: "fr", href: `${siteOrigin}/fr${relativeSuffix}` },
  { lang: "fr-FR", href: `${siteOrigin}/fr${relativeSuffix}` },
  { lang: "es", href: `${siteOrigin}/es${relativeSuffix}` },
  { lang: "es-ES", href: `${siteOrigin}/es${relativeSuffix}` },
  { lang: "it", href: `${siteOrigin}/it${relativeSuffix}` },
  { lang: "it-IT", href: `${siteOrigin}/it${relativeSuffix}` },
];

const ogLocales: Record<string, string> = {
  en: "en_US",
  de: "de_DE",
  fr: "fr_FR",
  es: "es_ES",
  it: "it_IT",
};
const ogLocale = ogLocales[lang] || "en_US";
---

<!doctype html>
<html lang={lang} data-theme="dark" class="dark">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    
    {/* Zero-flicker theme initialization. Re-runs on astro:after-swap because
        the ClientRouter's DOM morph re-applies each page's hardcoded
        data-theme="dark" default onto <html>, and identical inline scripts
        are not re-executed across soft navigations. */}
    <script is:inline>
      function __applyStoredTheme() {
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored ? stored : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      }
      __applyStoredTheme();
      document.addEventListener('astro:after-swap', __applyStoredTheme);
    </script>

    <link
      rel="dns-prefetch"
      href="//medusa-public-images.s3.eu-west-1.amazonaws.com"
    />
    <link
      rel="preconnect"
      href="https://medusa-public-images.s3.eu-west-1.amazonaws.com"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />

    {hreflangs.map((item) => (
      <link rel="alternate" hreflang={item.lang} href={item.href} />
    ))}

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={ogLocale} />
    {image && <meta property="og:image" content={image} />}

    <!-- Twitter Card -->
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
  </head>
  <body class="min-h-screen bg-[var(--color-bg-primary)] text-[var(--color-text-primary)] transition-colors duration-300">
    <div class="flex min-h-screen w-full flex-col">
      <Nav client:only="react" countryCode={countryCode} regionId={regionId} />
      <main class="flex-1 min-h-[calc(100vh-80px)]">
        <slot />
      </main>
      <Footer countryCode={countryCode} />
      <CartSidebar client:only="react" countryCode={countryCode} />
    </div>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100vh;
  }
</style>
