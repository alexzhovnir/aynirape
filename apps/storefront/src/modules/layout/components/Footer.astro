---
import { LanguageSelect } from "@components/LanguageSelect";

interface Props {
  countryCode: string;
}

const { countryCode } = Astro.props;
const currentYear = new Date().getFullYear();

const shopLinks = [
  { href: `/${countryCode}`, label: "Home" },
  { href: `/${countryCode}/store`, label: "All products" },
  { href: `/${countryCode}/music`, label: "Sacred Soundscapes (Music)" },
  { href: `/${countryCode}/blog`, label: "Blog" },
  { href: `/${countryCode}/cart`, label: "Cart" },
  { href: `/${countryCode}/checkout`, label: "Checkout" },
];

const companyLinks = [
  { href: `/${countryCode}/about`, label: "About Us" },
  { href: `/${countryCode}/contact`, label: "Contact" },
  { href: `/${countryCode}/delivery-and-payment`, label: "Delivery & Payment" },
  { href: `/${countryCode}/privacy-policy`, label: "Privacy Policy" },
  { href: `/${countryCode}/impressum`, label: "Impressum" },
  { href: `/sitemap.xml`, label: "Sitemap" },
  { href: `/llms.txt`, label: "AI Manifest (llms.txt)" },
];
---

<footer class="border-t border-[var(--color-border-subtle)] bg-[var(--color-bg-surface)] transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div
      class="grid gap-10 border-b border-[var(--color-border-subtle)] pb-10 md:grid-cols-2 xl:grid-cols-[1.2fr_0.8fr_0.8fr_1fr]"
    >
      <section class="max-w-md">
        <p
          class="text-xl font-serif-heading italic text-[var(--color-text-primary)] flex items-center gap-2"
        >
          <img src="/logo.svg" alt="Ayni Rapé" class="h-10 w-auto object-contain" />
        </p>
        <h2 class="mt-4 text-2xl font-serif-heading font-semibold tracking-tight text-[var(--color-text-primary)]">
          Sacred Amazonian Shamanic Supplies
        </h2>
        <p class="mt-4 text-sm leading-6 text-[var(--color-text-secondary)]">
          Ethically sourced rapé, tepi & kuripe applicators, aromatics, and ornaments, prepared in strict respect of traditional indigenous practices.
        </p>
      </section>

      <nav aria-label="Footer shop navigation">
        <p class="text-sm font-semibold text-[var(--color-text-primary)] uppercase tracking-wider">Shop</p>
        <ul class="mt-4 space-y-2.5 text-sm text-[var(--color-text-secondary)]">
          {
            shopLinks.map((link) => (
              <li>
                <a class="transition hover:text-[var(--color-accent-gold)]" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Footer company navigation">
        <p class="text-sm font-semibold text-[var(--color-text-primary)] uppercase tracking-wider">Company</p>
        <ul class="mt-4 space-y-2.5 text-sm text-[var(--color-text-secondary)]">
          {
            companyLinks.map((link) => (
              <li>
                <a
                  class="transition hover:text-[var(--color-accent-gold)]"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section>
        <p class="text-sm font-semibold text-[var(--color-text-primary)] uppercase tracking-wider">Age Restriction</p>
        <div class="mt-4 space-y-4 text-sm text-[var(--color-text-secondary)]">
          <p class="text-xs border border-[var(--color-border-subtle)] bg-[var(--color-bg-surface-elevated)] p-3.5 rounded-xl text-[var(--color-text-muted)] leading-relaxed">
            <strong class="text-[var(--color-accent-gold)]">Warning:</strong> To shop at AyniRape, you must be at least 18 years old. All products are supplied for ethnographic, scientific, and incense/ritual burning purposes.
          </p>
          <a
            class="inline-flex rounded-full bg-[var(--color-accent-gold)] px-6 py-2.5 text-xs font-bold text-stone-950 uppercase tracking-wider transition hover:bg-[var(--color-accent-gold-hover)] shadow-md"
            href={`/${countryCode}/store`}
          >
            Start shopping
          </a>
        </div>
      </section>
    </div>

    <!-- Contact & Social Bar -->
    <div class="py-6 border-b border-[var(--color-border-subtle)] flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2.5 text-sm">
        <span class="text-[var(--color-text-muted)] font-medium">Contact us:</span>
        <a 
          href="mailto:contact@aynirape.com" 
          class="font-bold text-[var(--color-text-primary)] hover:text-[var(--color-accent-gold)] transition-colors text-base tracking-wide"
        >
          contact@aynirape.com
        </a>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="https://www.instagram.com/ayni_rapeh"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Follow us on Instagram"
          class="w-10 h-10 rounded-full bg-[var(--color-bg-surface-elevated)] border border-[var(--color-border-subtle)] hover:border-[var(--color-accent-gold)] flex items-center justify-center text-[var(--color-text-primary)] hover:text-[var(--color-accent-gold)] transition-all duration-300 shadow-sm hover:scale-105"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Bottom Copyright & Region Selector Bar -->
    <div class="pt-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[var(--color-text-muted)] text-center md:text-left">
        &copy; {currentYear} Ayni Râpé. All rights reserved.
      </p>
      <div class="flex items-center gap-2">
        <span class="text-xs text-[var(--color-text-muted)]">Region:</span>
        <LanguageSelect client:load countryCode={countryCode} />
      </div>
    </div>
  </div>
</footer>
