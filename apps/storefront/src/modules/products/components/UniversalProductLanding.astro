---
import ImageCarouselWrapper from "./product-details/image-carousel/ImageCarouselWrapper.astro";
import { ProductActions } from "./product-details/ProductActions";
import ProductPreview from "./product-preview/ProductPreview.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import ShareButtons from "@components/ShareButtons.astro";
import { getLangFromRegion } from "@lib/i18n/config";

interface Props {
  product: any;
  region: any;
  cheapestPrice: any;
  t: (key: string) => any;
  countryCode: string;
  relatedProducts?: any[];
}

const { product, region, cheapestPrice, t, countryCode, relatedProducts = [] } = Astro.props;

const {
  title,
  description,
  images,
  thumbnail,
  options,
  variants,
  material,
  origin_country,
  type,
  weight,
  length,
  width,
  height,
} = product;

const metadata = product.metadata ?? {};

// BLOCK TOGGLE CONTROLS (Can be overridden per product via metadata in Medusa Admin)
const showUsps = metadata.show_usps !== false;
const showComposition = metadata.show_composition !== false;
const showIntensity = metadata.show_intensity !== false;
const showTribalLineage = metadata.show_tribal_lineage !== false;
const showComparison = metadata.show_comparison !== false;
const showRitual = metadata.show_ritual !== false;
const showCare = metadata.show_care !== false;
const showAudio = metadata.show_audio !== false;
const showAuthenticity = metadata.show_authenticity !== false;
const showReviews = metadata.show_reviews !== false;
const showFaqs = metadata.show_faqs !== false;
const showPairings = metadata.show_pairings !== false;

// Helper to generate dynamic category-tailored localized fallback descriptions
const getFallbackDescription = (tName: string, hName: string, cCode: string) => {
  const tLower = (tName || "").toLowerCase();
  const hLower = (hName || "").toLowerCase();
  const lang = getLangFromRegion(cCode);

  const isDE = lang === "de";
  const isFR = lang === "fr";
  const isES = lang === "es";
  const isIT = lang === "it";

  if (tLower.includes("kuripe") || tLower.includes("tepi") || hLower.includes("kuripe") || hLower.includes("tepi")) {
    if (isDE) return "Handgefertigter amazonischer schamanischer Applikator für sanften, ergonomischen Luftstrom bei heiligen Rapé-Ritualen.";
    if (isFR) return "Applicateur chamanique amazonien fait main, conçu pour un flux d'air fluide et ergonomique lors des rituels sacrés du Rapé.";
    if (isES) return "Aplicador chamánico amazónico hecho a mano, diseñado para un flujo de aire suave y ergonómico durante los rituales sagrados de Rapé.";
    if (isIT) return "Applicatore sciamanico amazzonico fatto a mano, progettato per un flusso d'aria fluido ed ergonomico durante i rituali sacri di Rapé.";
    return "Handcrafted Amazonian shamanic applicator designed for smooth, ergonomic airflow during sacred Rapé facilitation and meditation rituals.";
  }

  if (tLower.includes("agua") || tLower.includes("florida") || tLower.includes("palo santo") || hLower.includes("agua") || hLower.includes("palo-santo")) {
    if (isDE) return "Authentische peruanische zeremonielle aromatische Essenz zur sofortigen Raumreinigung, Aura-Klärung und Ritualvorbereitung.";
    if (isFR) return "Essence aromatique cérémonielle péruvienne authentique pour la purification instantanée de l'espace, le nettoyage de l'aura et la préparation aux rituels.";
    if (isES) return "Esencia aromática ceremonial peruana auténtica para la purificación instantánea del espacio, limpieza del aura y preparación ritual.";
    if (isIT) return "Essenza aromatica cerimoniale peruviana autentica per la purificazione istantanea dello spazio, la pulizia dell'aura e la preparazione ai rituali.";
    return "Authentic Peruvian ceremonial aromatic essence for instant space purification, aura cleansing, and ritual preparation.";
  }

  if (tLower.includes("bundle") || tLower.includes("carpet") || tLower.includes("bracelet") || hLower.includes("bundle") || hLower.includes("carpet")) {
    if (isDE) return "Kuratierte schamanische Ausrüstung aus natürlichen Materialien zur Erdung Ihrer Energie und Bereicherung Ihrer spirituellen Praxis.";
    if (isFR) return "Ensemble chamanique sélectionné, fabriqué à partir de matériaux naturels pour ancrer votre énergie et enrichir votre pratique spirituelle.";
    if (isES) return "Conjunto chamánico seleccionado, elaborado con materiales naturales para enraizar tu energía y enriquecer tu práctica espiritual.";
    if (isIT) return "Set sciamanico curato, realizzato con materiali naturali per radicare la tua energia e arricchire la tua pratica spirituale.";
    return "Curated shamanic set crafted with natural materials to ground your energy and enhance your spiritual practice.";
  }

  // Rapé blends default
  if (isDE) return "Authentische biologische amazonische Rapé-Mischung, zubereitet mit traditioneller Baumrindenasche und wildem Mapacho von Stammesältesten.";
  if (isFR) return "Mélange authentique de Rapé amazonien biologique préparé avec de la cendre d'écorce sacrée et du Mapacho sauvage par les aînés des tribus.";
  if (isES) return "Mezcla auténtica de Rapé amazónico orgánico preparada con ceniza sagrada de corteza de árbol y Mapacho silvestre por los ancianos tribales.";
  if (isIT) return "Miscela autentica di Rapé amazzonico biologico preparata con cenere di corteccia sacra e Mapacho selvatico dagli anziani della tribù.";
  return "Authentic organic Amazonian Rapé blend prepared with traditional sacred tree bark ash and wild Mapacho leaf by tribal elders.";
};

const displayImages = images && images.length > 0 ? images : (thumbnail ? [{ url: thumbnail }] : []);
const descriptionParagraphs = (description ?? "").split(/\r?\n\n/).map(p => p.trim()).filter(Boolean);
const hasCustomDescription = descriptionParagraphs.length > 0;

const shortSellingDescription = hasCustomDescription
  ? descriptionParagraphs[0]
  : getFallbackDescription(title || "", product.handle || "", countryCode);

const secondaryDescription = hasCustomDescription && descriptionParagraphs.length > 1
  ? descriptionParagraphs[1]
  : null;

// Determine product category type
const titleLower = (title || "").toLowerCase();
const handleLower = (product.handle || "").toLowerCase();

const isApplicator = titleLower.includes("kuripe") || titleLower.includes("tepi") || handleLower.includes("kuripe") || handleLower.includes("tepi");
const isAromatic = titleLower.includes("agua") || titleLower.includes("florida") || titleLower.includes("palo santo") || titleLower.includes("incense") || handleLower.includes("agua") || handleLower.includes("palo-santo");
const isBundle = titleLower.includes("bundle") || titleLower.includes("discovery") || handleLower.includes("bundle");
const isOrnament = titleLower.includes("carpet") || titleLower.includes("bracelet") || titleLower.includes("cloth") || handleLower.includes("carpet") || handleLower.includes("bracelet");
const isRape = !isApplicator && !isAromatic && !isBundle && !isOrnament; // Default to Rapé blend

// Dynamic Category Badges & Labels
let categoryBadge = "🌿 Amazonian Sacred Medicine";
let subBadge = "✨ Ethically Sourced & Fair Trade";
if (isApplicator) {
  categoryBadge = titleLower.includes("silver") ? "🐍 925 Sterling Silver Masterpiece" : "🪵 Handcrafted Sacred Applicator";
  subBadge = "⚡ Ergonomic Ceremonial Airflow";
} else if (isAromatic) {
  categoryBadge = "💧 Authentic Peru Import";
  subBadge = "🧹 Space & Aura Purification";
} else if (isBundle) {
  categoryBadge = "🎁 Curated Sacred Set";
  subBadge = "⚡ Special Bundle Value";
} else if (isOrnament) {
  categoryBadge = "🎨 Handwoven Altar Artistry";
  subBadge = "🛡️ Sacred Protection & Energy";
}

// Intensity & Dosage Level
const intensityScore = metadata.intensity ? Number(metadata.intensity) : (isApplicator ? 4 : (isAromatic ? 3 : 4));
const intensityLabel = metadata.intensity_label || (
  intensityScore === 5 ? "Deep Master Level • Strong Grounding" :
  intensityScore === 4 ? "Grounded & Focused • High Potency" :
  intensityScore === 3 ? "Balanced & Harmonious • Daily Use" : "Gentle & Smoothing • Ideal for Beginners"
);

// Tribal Lineage Info
const tribalName = metadata.tribal_lineage || (
  titleLower.includes("yawanawa") ? "Yawanawá Tribe (Acre, Brazil)" :
  titleLower.includes("huni kuin") ? "Huni Kuin / Kaxinawá Tribe (Brazil/Peru)" :
  titleLower.includes("nukini") ? "Nukini Tribe (Serra do Divisor)" :
  titleLower.includes("katukina") ? "Katukina Tribe (Amazonas)" :
  titleLower.includes("shipibo") ? "Shipibo-Conibo Tradition (Pucallpa, Peru)" :
  "Amazonian Sacred Lineage (Peru & Brazil)"
);

// Category-Tailored USPs
const getUsps = () => {
  if (isApplicator) {
    return [
      { icon: "⚡", title: "Ergonomic Airflow Precision", text: "Specifically angled barrels ensure smooth, airtight contact for effortless self or partner facilitation." },
      { icon: "🪵", title: "Sacred Hardwood & Pure Silver", text: "Crafted from heavy Amazonian Sawo/Teak hardwood, 925 sterling silver, or natural stone for high vibrational resonance." },
      { icon: "🐍", title: "Ancestral Totem Carvings", text: "Hand-carved jaguar, serpent, eagle, or Shipibo patterns representing spiritual protection and strength." },
      { icon: "🛡️", title: "Lifetime Quality Guarantee", text: "Built to last a lifetime of ceremonial work. Natural, durable, and easy to clean." }
    ];
  } else if (isAromatic) {
    return [
      { icon: "💧", title: "100% Authentic Peru Import", text: "Genuine Peruvian Agua de Florida and wild-harvested Palo Santo wood resin, direct from origin." },
      { icon: "🧹", title: "Instant Space Clearing", text: "Clears heavy emotional and energetic residue from rooms, altars, and human aura within seconds." },
      { icon: "🌸", title: "Pure Botanical Essence", text: "Rich natural blend of citrus, blossom, and resin oils creating a grounded, sacred atmosphere." },
      { icon: "🧘", title: "Essential Ceremony Partner", text: "The ideal ritual companion for purifying space before Rapé, meditation, or sound healing sessions." }
    ];
  } else if (isBundle) {
    return [
      { icon: "🎁", title: "Complete Sacred Synergy", text: "Curated combinations of Rapé blends, applicators, and aromatics designed to work in perfect harmony." },
      { icon: "⚡", title: "Exceptional Value Savings", text: "Save significantly compared to purchasing individual items separately." },
      { icon: "🌱", title: "Full Spectrum Experience", text: "Explore varying intensities and varieties to discover what best serves your spiritual practice." },
      { icon: "📦", title: "Sacred Gift Box", text: "Beautifully presented in eco-friendly protective packaging, ready for gifting or ceremonial use." }
    ];
  } else if (isOrnament) {
    return [
      { icon: "🎨", title: "Handwoven Ancestral Craft", text: "Intricately woven by native Amazonian and Andean artisans using traditional loom techniques." },
      { icon: "🛡️", title: "Sacred Symbol Protection", text: "Featuring snake, hummingbird, and sacred plant geometry that anchors protective light in your space." },
      { icon: "✨", title: "Premium Natural Fibers", text: "Durable, eco-friendly materials designed for shamanic altars, meditation corners, or personal adornment." },
      { icon: "🤝", title: "Direct Fair Trade Support", text: "Every purchase directly supports artisan families and helps preserve ancient craftsmanship." }
    ];
  } else {
    return [
      { icon: "🌿", title: "Authentic Tribal Sourcing", text: "Ethically harvested and prepared by Amazonian indigenous elders (Huni Kuin, Yawanawa, Nukini, Katukina)." },
      { icon: "🧠", title: "Deep Grounding & Clarity", text: "Instantly quiets overthinking, clears mental fog, and centers awareness in the present moment." },
      { icon: "🔥", title: "Sacred Ash & Botanical Blend", text: "Made with Tsunu, Paricá, or Emburana ash blended with wild organic mapacho and medicinal herbs." },
      { icon: "🤝", title: "Ethical Fair Trade", text: "Purchases directly support tribal communities, rainforest conservation, and indigenous heritage." }
    ];
  }
};

// Composition & Materials Data
const getCompositionMaterials = () => {
  if (isApplicator) {
    return {
      title: "Sacred Materials & Craftsmanship",
      subtitle: "100% Natural Organic Amazonian Hardwood & Artisanal Finish",
      items: [
        { icon: "🪵", name: "Primary Hardwood Core", desc: "Crafted from high-density Amazonian Sawo Wood, Teak, or Tamarind. Naturally water-resistant, durable, and antimicrobial." },
        { icon: "🐝", name: "Natural Organic Sealant", desc: "Joints sealed with pure natural beeswax and non-toxic native tree resin for airtight blowing integrity." },
        { icon: "🌿", name: "Botanical Oil Polish", desc: "Hand-finished with organic jojoba and coconut oil. Zero synthetic lacquers, artificial paints, or toxic chemicals." },
        { icon: "📐", name: "Calibrated Ergonomics", desc: "Precision 45° angled barrels hand-sanded to provide comfortable facial contact and smooth, quiet airflow." }
      ]
    };
  } else if (isAromatic) {
    return {
      title: "Sacred Formula & Botanical Origin",
      subtitle: "100% Genuine Peruvian Distillate & Wild-Harvested Resins",
      items: [
        { icon: "🍊", name: "Citrus Essence Blend", desc: "Natural orange blossom, bergamot, and lemon essential oils providing bright, uplifting energy." },
        { icon: "💧", name: "Andean Spring Water", desc: "Formulated with pure Andean water distillate and alcohol for rapid evaporation and energy clearing." },
        { icon: "🪵", name: "Wild-Harvested Palo Santo", desc: "Sustainably collected Bursera graveolens wood from naturally fallen branches aged 4-10 years on forest floor." },
        { icon: "🧹", name: "Purity Certification", desc: "0% synthetic artificial scents. 100% authentic formula prepared according to traditional Peruvian heritage." }
      ]
    };
  } else {
    return {
      title: "Sacred Botanical Composition",
      subtitle: "100% Pure Organic Amazonian Leaf & Tribal Tree Bark Ash",
      items: [
        { icon: "🍃", name: "Organic Mapacho Base", desc: "Wild Nicotiana rustica leaf harvested with prayer and dried in shade by Amazonian tribal elders." },
        { icon: "🔥", name: "Ceremonial Tree Bark Ash", desc: "Pure ash of Tsunu, Paricá, Murici, or Cumaru sacred trees burned in traditional ceremonial fires." },
        { icon: "🌿", name: "Medicinal Amazonian Herbs", desc: "Native rainforest mint, eucalyptus, or sacred leaves for aroma, grounding, and nasal passage opening." },
        { icon: "✨", name: "Zero Chemical Additives", desc: "100% pure organic plant material. Free from synthetic chemicals, artificial fragrances, or heavy fillers." }
      ]
    };
  }
};

// Care & Maintenance Data
const getCareInstructions = () => {
  if (isApplicator) {
    return [
      { step: "01", title: "Sanitize After Use", text: "Wipe the exterior and tips with a soft cloth moistened with a few drops of Agua de Florida or organic alcohol." },
      { step: "02", title: "Clean Barrels Dry", text: "Use a thin, dry natural pipe cleaner or cotton swab to remove residual Rapé powder inside the tubes. Avoid soaking wood in water." },
      { step: "03", title: "Condition & Nourish Wood", text: "Rub a tiny drop of organic coconut or jojoba oil onto the hardwood every 2-3 months to preserve its rich natural grain." }
    ];
  } else if (isAromatic) {
    return [
      { step: "01", title: "Storage", text: "Keep bottle or Palo Santo sticks tightly closed in a cool, dry place away from direct sunlight." },
      { step: "02", title: "Flame Safety", text: "When burning Palo Santo sticks, allow flame to burn for 30 seconds before gently blowing out to release fragrant smoke." },
      { step: "03", title: "Ceremonial Use", text: "Apply a few drops to hands or smudge space prior to meditation or sacred Rapé rituals for maximum clarity." }
    ];
  } else {
    return [
      { step: "01", title: "Airtight Storage", text: "Keep Rapé in an airtight glass or metal container in a cool, dark, dry environment." },
      { step: "02", title: "Moisture Protection", text: "Always use clean, dry utensils or measuring spoons to prevent moisture from entering the container." },
      { step: "03", title: "Preservation", text: "Stored properly away from humidity, organic Rapé retains its full freshness and energetic potency for years." }
    ];
  }
};

// Category-Tailored Problem vs Solution
const getComparison = () => {
  if (isApplicator) {
    return {
      title: "Mass-Produced Pipes vs. Sacred Hand-Carved Applicator",
      standardTitle: "Generic / Mass-Produced Pipes",
      standardList: [
        "Rough interior barrels that obstruct smooth airflow.",
        "Cheaper synthetic glue or plastic materials that degrade.",
        "Uncomfortable fit causing air leaks during blow."
      ],
      premiumTitle: `${title} Applicator`,
      premiumList: [
        "Hand-sanded interior channels for flawless, effortless airflow.",
        "100% natural Amazonian hardwood, 925 silver & organic resin.",
        "Ergonomically contoured tips for comfortable, airtight fit."
      ]
    };
  } else if (isAromatic) {
    return {
      title: "Synthetic Sprays vs. Authentic Sacred Aromatics",
      standardTitle: "Artificial / Synthetic Fragrances",
      standardList: [
        "Chemical solvents and artificial perfumes that irritate nose.",
        "No energetic purification properties or sacred intent.",
        "Commercially mass-manufactured with cheap additives."
      ],
      premiumTitle: `${title} Sacred Aromatic`,
      premiumList: [
        "100% authentic Peruvian formula & wild-harvested botanicals.",
        "Used for generations by shamans for aura & space clearing.",
        "Pure, refreshing, and deeply grounding natural fragrance."
      ]
    };
  } else {
    return {
      title: "Industrial Commercial Products vs. Sacred Amazonian Rapé",
      standardTitle: "Commercial / Industrial Products",
      standardList: [
        "Contains chemical additives, artificial flavors, or heavy preservatives.",
        "Unblessed mass production lacking ceremonial intention.",
        "Exploitative supply chains with no benefit to origin tribes."
      ],
      premiumTitle: `${title} Sacred Blend`,
      premiumList: [
        "100% pure organic Amazonian leaf & sacred tree ashes.",
        "Crafted with traditional prayers, singing, and sacred focus.",
        "Direct fair trade empowering Amazonian indigenous families."
      ]
    };
  }
};

// Category-Tailored Ritual Steps
const getRitualSteps = () => {
  if (isApplicator) {
    return [
      { step: "01", title: "Purify Your Tool", text: "Wipe your applicator with Agua de Florida or smudge with Palo Santo to clear residual energy." },
      { step: "02", title: "Measure Medicine", text: "Carefully place a pea-sized amount of sacred Rapé powder into the applicator barrel." },
      { step: "03", title: "Align Position", text: "Place the long end to your mouth and gently insert tip into nostril with comfortable contact." },
      { step: "04", title: "Mindful Blow", text: "Deliver a calm, continuous blow. Close eyes and integrate the grounding energy." }
    ];
  } else if (isAromatic) {
    return [
      { step: "01", title: "Set Intention", text: "Take a deep breath and clarify what energy you wish to clear or invite into your space." },
      { step: "02", title: "Apply / Light", text: "Splash or spray Agua de Florida on hands, or ignite Palo Santo stick until glowing." },
      { step: "03", title: "Cleanse Aura", text: "Pass hands or fragrant smoke around your head, chest, and ceremonial altar." },
      { step: "04", title: "Settle into Stillness", text: "Enjoy the refreshed, pure atmosphere as you enter meditation or ritual." }
    ];
  } else {
    return [
      { step: "01", title: "Cleanse Space", text: "Smudge your surroundings with Palo Santo or spray Agua de Florida to quiet the environment." },
      { step: "02", title: "Set Intention", text: "Hold the medicine close to your heart, stating your intention for clarity, healing, or grounding." },
      { step: "03", title: "Receive Medicine", text: "Use your Kuripe or Tepi to deliver the sacred blow into each nostril." },
      { step: "04", title: "Integrate & Rest", text: "Sit softly with eyes closed for 5-15 minutes as the medicine grounds your energy." }
    ];
  }
};

// Reviews Data for Social Proof
const reviews = [
  {
    author: "Elena M.",
    location: "Munich, Germany",
    role: "Verified Facilitator",
    rating: 5,
    date: "July 18, 2026",
    title: "Exceptional quality and fast delivery",
    content: `The ${title} exceeded my expectations. You can feel the care and sacred intention in the craftsmanship. Arrived in 2 days in Munich with eco discreet packaging.`
  },
  {
    author: "Dr. Julian V.",
    location: "Zurich, Switzerland",
    role: "Holistic Practitioner",
    rating: 5,
    date: "June 29, 2026",
    title: "Pure, authentic & powerful",
    content: `I use ${title} regularly in my practice. The energy is pure, grounded, and very high quality. I recommend Ayni Rapé to all my clients.`
  },
  {
    author: "Sophie K.",
    location: "Vienna, Austria",
    role: "Meditation Guide",
    rating: 5,
    date: "June 14, 2026",
    title: "Best ceremonial shop in Europe",
    content: `Fantastic customer service and genuine items directly from South America. ${title} is now a cornerstone of my daily ritual.`
  },
  {
    author: "Marcus B.",
    location: "Berlin, Germany",
    role: "Ceremonial Organizer",
    rating: 5,
    date: "May 22, 2026",
    title: "Top tier craftsmanship",
    content: `Solid packaging, fast shipping, and 100% authentic quality. Will definitely be ordering more for our upcoming retreats.`
  }
];

// FAQs Data for Objection Handling
const getFaqs = () => {
  if (isApplicator) {
    return [
      { q: "How do I choose between a Kuripe (self) and Tepi (partner)?", a: "A Kuripe is V-shaped for applying Rapé to yourself. A Tepi is longer for a facilitator to blow Rapé into another person's nostrils during ceremony." },
      { q: "How do I clean and sanitize wooden or silver applicators?", a: "Wipe the exterior with a soft cloth and a drop of Agua de Florida. For inner barrels, use a thin dry pipe cleaner. Avoid submerging wooden items in water." },
      { q: "What materials are used?", a: "We only use ethically sourced Amazonian hardwoods (such as Sawo, Tamarind, Teak), certified 925 sterling silver, and natural stones." },
      { q: "Is shipping discreet and insured worldwide?", a: "Yes! All packages are sent in plain eco-friendly boxes with no external mention of sacred items, fully insured with tracking." },
      { q: "What is your return policy?", a: "We offer a 30-day return & exchange guarantee on unused items in original packaging." }
    ];
  } else if (isAromatic) {
    return [
      { q: "Is this genuine Peruvian import?", a: "Yes, our Agua de Florida is bottled by Murray & Lanman in Peru, and our Palo Santo is sustainably harvested in Peru from naturally fallen trees." },
      { q: "How do I use this for energy clearing?", a: "Splash a few drops of Agua de Florida onto your palms, rub them together, and sweep over your head and shoulders, or burn a Palo Santo stick and waft smoke over your altar." },
      { q: "Is Palo Santo ethically harvested?", a: "100% yes. We only work with licensed Peruvian suppliers who harvest exclusively from naturally fallen branches that have aged on the forest floor." },
      { q: "How fast is shipping to Europe?", a: "Standard EU delivery takes 2-4 business days, and express shipping delivers within 24-48 hours." }
    ];
  } else {
    return [
      { q: "How do I choose the right Rapé blend for me?", a: "If you are new, start with balanced blends like Nukini Sansara or Huni Kuin. For strong grounding and clearing, try Yawanawa Tsunu or Caboclo Paricá." },
      { q: "How should I store Rapé to keep it fresh?", a: "Keep Rapé in an airtight glass or metal container away from direct sunlight, moisture, and extreme heat. Stored properly, it remains fresh for years." },
      { q: "Is shipping discreet and legal in my country?", a: "We ship discreetly in plain unbranded packaging across all EU countries, Switzerland, UK, and worldwide with express tracking." },
      { q: "What is your satisfaction guarantee?", a: "We stand behind the quality of all our sacred tools. If you have any issue with your order, contact us for a hassle-free replacement or return within 30 days." }
    ];
  }
};

const usps = getUsps();
const compositionMaterials = getCompositionMaterials();
const careInstructions = getCareInstructions();
const comparison = getComparison();
const ritualSteps = getRitualSteps();
const faqs = getFaqs();

const displayMaterial = material || (isApplicator ? "Amazonian Hardwood & Organic Beeswax" : (isAromatic ? "Natural Essential Oils & Distillate" : "Organic Amazonian Leaf & Tree Bark Ash"));
const displayOrigin = origin_country || "Sacred Valley, Peru / Amazonian Rainforest";
const displayType = type?.value || (isApplicator ? "Sacred Applicator Pipe" : (isAromatic ? "Cleansing Essence" : "Ceremonial Botanical Blend"));
const displayWeight = weight ? `${weight} g` : "Approx. 35 g - 60 g";
const displayDimensions = (length && width && height) ? `${length} × ${width} × ${height} cm` : "Ergonomic Handheld Fit";

const rawSku = variants?.[0]?.sku || metadata?.sku;
const generatedSku = `AYNI-${handleLower.slice(0, 12).toUpperCase().replace(/[^A-Z0-9]/g, "")}-01`;
const displaySku = rawSku || generatedSku;
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-12 space-y-16 text-[var(--color-text-primary)] font-sans-body">

  <!-- Breadcrumbs Nav -->
  <Breadcrumbs
    items={[
      { label: String(t("nav.home")), href: `/${countryCode}` },
      { label: String(t("nav.shop")), href: `/${countryCode}/store` },
      ...(product.categories?.[0] ? [{ label: product.categories[0].name, href: `/${countryCode}/store/category/${product.categories[0].handle}` }] : []),
      { label: title ?? String(t("nav.product")) }
    ]}
  />

  <!-- HERO & MAIN BUY BOX SECTION -->
  <section class="bg-[var(--color-bg-surface-elevated)] p-6 sm:p-10 lg:p-12 rounded-3xl border border-[var(--color-border-subtle)] shadow-xl relative overflow-hidden">
    <div class="absolute -top-32 -right-32 w-96 h-96 bg-[var(--color-accent-gold)]/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Top Left Corner Badges -->
    <div class="absolute top-5 left-6 sm:top-6 sm:left-8 z-30 flex flex-row flex-wrap items-center gap-2">
