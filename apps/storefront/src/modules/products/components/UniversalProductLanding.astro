<script>
  // Audio Player Toggle Script
  const audioBtn = document.getElementById('btn-play-audio');
  if (audioBtn) {
    let audio: HTMLAudioElement | null = null;
    let isPlaying = false;

    audioBtn.addEventListener('click', () => {
      if (!audio) {
        // High quality ambient flute stream
        audio = new Audio('https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=meditation-flute-112340.mp3');
      }

      if (isPlaying) {
        audio.pause();
        audioBtn.textContent = '▶';
        isPlaying = false;
      } else {
        audio.play().catch(e => console.log('Audio autoplay prevented', e));
        audioBtn.textContent = '⏸';
        isPlaying = true;
      }
    });
  }

  // Show sticky bottom bar when user scrolls past main hero buy box & connect click handler
  const stickyBar = document.getElementById('sticky-cart-bar');
  const stickyBtn = document.getElementById('sticky-add-to-cart-btn');

  if (stickyBtn) {
    stickyBtn.addEventListener('click', () => {
      const mainBtn = document.getElementById('main-add-to-cart-btn');
      if (mainBtn) {
        mainBtn.click();
      }
    });
  }

  if (stickyBar) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 600) {
        stickyBar.classList.remove('translate-y-full');
      } else {
        stickyBar.classList.add('translate-y-full');
      }
    });
  }
</script>
