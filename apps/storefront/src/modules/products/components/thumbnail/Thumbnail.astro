---
import { Image } from "astro:assets";
import PlaceholderImage from "./PlaceholderImage.astro";

interface Props {
  imageUrl?: string;
  title: string;
  priority?: boolean;
}

const { imageUrl, title, priority = false } = Astro.props;
---

<div class="hover:shadow-sm ease-in-out duration-200 w-full flex items-center justify-center">
  <div class="overflow-hidden rounded-2xl w-full aspect-[4/5] bg-[var(--color-bg-surface-elevated)] border border-[var(--color-border-subtle)] relative flex items-center justify-center">
    {
      imageUrl ? (
        <img
          src={imageUrl}
          alt={title}
          class="w-full h-full object-cover rounded-2xl group-hover:scale-105 transition-transform duration-500 ease-out"
          loading={priority ? "eager" : "lazy"}
          decoding="async"
        />
      ) : (
        <div class="w-full h-full border border-[var(--color-border-subtle)] flex items-center justify-center text-[var(--color-text-muted)] group-hover:bg-[var(--color-bg-surface)] transition-colors duration-200 rounded-2xl">
          <PlaceholderImage size={48} />
        </div>
      )
    }
  </div>
</div>
