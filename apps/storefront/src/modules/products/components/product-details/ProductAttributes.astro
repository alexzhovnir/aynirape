---
interface Props {
  material?: string | null;
  origin_country?: string | null;
  type?: { value: string } | null;
  weight?: number | null;
  length?: number | null;
  width?: number | null;
  height?: number | null;
  metadata?: Record<string, any> | null;
}

const { material, origin_country, type, weight, length, width, height, metadata } =
  Astro.props;
---

<div class="mb-2">
  <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--color-accent-gold)] mb-4">Specifications & Origin</h3>
  
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-xs">
    {metadata?.tribe && (
      <div class="bg-[var(--color-bg-surface-elevated)] p-3 rounded-xl border border-[var(--color-border-subtle)]">
        <span class="block text-[var(--color-text-muted)] font-medium mb-1">Tribe / Origin</span>
        <strong class="text-[var(--color-text-primary)]">{metadata.tribe}</strong>
      </div>
    )}
    
    {metadata?.strength && (
      <div class="bg-[var(--color-bg-surface-elevated)] p-3 rounded-xl border border-[var(--color-border-subtle)]">
        <span class="block text-[var(--color-text-muted)] font-medium mb-1">Strength</span>
        <span class="inline-block bg-[var(--color-accent-gold)]/10 text-[var(--color-accent-gold)] font-bold px-2 py-0.5 rounded-md mt-0.5">
          {metadata.strength}
        </span>
      </div>
    )}
    
    {metadata?.ingredients && (
      <div class="bg-[var(--color-bg-surface-elevated)] p-3 rounded-xl border border-[var(--color-border-subtle)] col-span-2 sm:col-span-1">
        <span class="block text-[var(--color-text-muted)] font-medium mb-1">Ingredients</span>
        <strong class="text-[var(--color-text-primary)]">{metadata.ingredients}</strong>
      </div>
    )}

    {material && (
      <div class="bg-[var(--color-bg-surface-elevated)] p-3 rounded-xl border border-[var(--color-border-subtle)]">
        <span class="block text-[var(--color-text-muted)] font-medium mb-1">Material</span>
        <strong class="text-[var(--color-text-primary)]">{material}</strong>
      </div>
    )}

    {origin_country && (
      <div class="bg-[var(--color-bg-surface-elevated)] p-3 rounded-xl border border-[var(--color-border-subtle)]">
        <span class="block text-[var(--color-text-muted)] font-medium mb-1">Country of Origin</span>
        <strong class="text-[var(--color-text-primary)]">{origin_country}</strong>
      </div>
    )}

    {type?.value && (
      <div class="bg-[var(--color-bg-surface-elevated)] p-3 rounded-xl border border-[var(--color-border-subtle)]">
        <span class="block text-[var(--color-text-muted)] font-medium mb-1">Category Type</span>
        <strong class="text-[var(--color-text-primary)]">{type.value}</strong>
      </div>
    )}

    {weight && (
      <div class="bg-[var(--color-bg-surface-elevated)] p-3 rounded-xl border border-[var(--color-border-subtle)]">
        <span class="block text-[var(--color-text-muted)] font-medium mb-1">Weight</span>
        <strong class="text-[var(--color-text-primary)]">{weight}g</strong>
      </div>
    )}

    {(length || width || height) && (
      <div class="bg-[var(--color-bg-surface-elevated)] p-3 rounded-xl border border-[var(--color-border-subtle)]">
        <span class="block text-[var(--color-text-muted)] font-medium mb-1">Dimensions</span>
        <strong class="text-[var(--color-text-primary)]">{length || '-'}L x {width || '-'}W x {height || '-'}H</strong>
      </div>
    )}
  </div>
</div>
