---
import { getProductPrice } from "../../../../lib/utils/get-product-price";
import type { ProductVariant } from "../../../../types/global";
import Thumbnail from "../thumbnail/Thumbnail.astro";
import Price from "./Price.astro";

interface Props {
  id: string;
  handle?: string;
  variants: ProductVariant[];
  thumbnailUrl?: string;
  imageUrl?: string;
  title: string;
  priority?: boolean;
}

const { id, handle, variants, thumbnailUrl, imageUrl, title, priority } = Astro.props;
const countryCode = Astro.params.countryCode;
const productSlug = handle || id;

const { cheapestPrice } = getProductPrice({
  productVariants: variants,
});

// Calculate sizes (simplified logic for the UI)
const sizes = variants?.map(v => v.title).filter(t => t.includes('g') || t.includes('ml')).join(', ') || "5g, 10g, 20g";
---

<a
  href={`/${countryCode}/store/${productSlug}`}
  class="group flex h-full flex-col bg-transparent w-full max-w-[320px] mx-auto transition-transform duration-300 hover:-translate-y-1"
>
  <div class="relative w-full aspect-square">
    <!-- Heart Icon -->
    <button class="absolute top-2 left-2 z-10 p-2.5 rounded-full bg-[#D0D9DF]/90 text-white hover:bg-[#b0bdc6] transition-colors" aria-label="Add to favorites" onclick="event.preventDefault();">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
      </svg>
    </button>
    
    <!-- Popular Badge -->
    <div class="absolute top-4 right-4 z-10 px-3 py-1 rounded-md bg-[#C2DA16] text-white text-xs font-bold uppercase tracking-wider shadow-sm">
      Popular
    </div>
    
    <Thumbnail imageUrl={thumbnailUrl || imageUrl} title={title} priority={priority} />
  </div>

  <div class="mt-6 flex flex-col items-center text-center gap-1.5">
    <h3 class="text-xl font-bold text-[#2C2C2C] group-hover:text-[#C2DA16] transition-colors line-clamp-2 leading-tight">
      {title}
    </h3>
    
    <div class="text-[#C2DA16] font-semibold text-sm">
      In stock
    </div>
    
    <div class="flex items-center gap-2 text-sm mt-1">
      <span class="text-[#9DA5AA] font-medium">Size</span>
      <span class="text-[#9DA5AA]">{sizes}</span>
    </div>
    
    <div class="w-full flex items-center justify-between mt-4">
      <div class="text-[28px] font-extrabold text-[#C2DA16] tracking-tight">
        {
          cheapestPrice && (
            <Price
              priceType={cheapestPrice.price_type ?? ""}
              originalPrice={cheapestPrice.original_price}
              calculatedPrice={cheapestPrice.calculated_price}
            />
          )
        }
      </div>
      
      <button class="bg-[#2C2C2C] text-white p-3 rounded-full hover:bg-black transition-colors" aria-label="Add to cart" onclick="event.preventDefault();">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
      </button>
    </div>
  </div>
</a>
