---
import { getProductPrice } from "../../../../lib/utils/get-product-price";
import type { ProductVariant } from "../../../../types/global";
import Thumbnail from "../thumbnail/Thumbnail.astro";
import Price from "./Price.astro";

interface Props {
  id: string;
  handle?: string;
  variants: ProductVariant[];
  thumbnailUrl?: string;
  imageUrl?: string;
  title: string;
  priority?: boolean;
}

const { id, handle, variants, thumbnailUrl, imageUrl, title, priority } = Astro.props;
const countryCode = Astro.params.countryCode;
const productSlug = handle || id;

const { cheapestPrice } = getProductPrice({
  productVariants: variants,
});
---

<a
  href={`/${countryCode}/store/${productSlug}`}
  class="group flex h-full flex-col justify-between rounded-2xl p-4 bg-[var(--color-card-bg)] border border-[var(--color-card-border)] shadow-sm hover:shadow-lg hover:border-[var(--color-accent-gold)] transition-all duration-300 transform hover:-translate-y-1 w-full max-w-[280px] mx-auto"
>
  <div class="relative overflow-hidden rounded-xl bg-[var(--color-bg-surface-elevated)] p-2">
    <Thumbnail imageUrl={thumbnailUrl || imageUrl} title={title} priority={priority} />
  </div>

  <div class="mt-3 flex flex-col gap-1.5">
    <h3 class="text-sm font-semibold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-gold)] transition-colors line-clamp-2">
      {title}
    </h3>
    
    <div class="flex items-center justify-between mt-1 pt-2 border-t border-[var(--color-border-subtle)]">
      <span class="text-xs font-medium text-[var(--color-text-muted)] uppercase tracking-wider">Price</span>
      <div class="text-sm font-bold text-[var(--color-accent-gold)]">
        {
          cheapestPrice && (
            <Price
              priceType={cheapestPrice.price_type ?? ""}
              originalPrice={cheapestPrice.original_price}
              calculatedPrice={cheapestPrice.calculated_price}
            />
          )
        }
      </div>
    </div>
  </div>
</a>
