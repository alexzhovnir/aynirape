---
import { getProductPrice } from "../../../../lib/utils/get-product-price";
import type { ProductVariant } from "../../../../types/global";
import Thumbnail from "../thumbnail/Thumbnail.astro";
import Price from "./Price.astro";

interface Props {
  id: string;
  handle?: string;
  variants: ProductVariant[];
  thumbnailUrl?: string;
  imageUrl?: string;
  title: string;
  priority?: boolean;
}

const { id, handle, variants, thumbnailUrl, imageUrl, title, priority } = Astro.props;
const countryCode = Astro.params.countryCode;
const productSlug = handle || id;

const { cheapestPrice } = getProductPrice({
  productVariants: variants,
});

// Calculate sizes (simplified logic for the UI)
const sizes = variants?.map(v => v.title).filter(t => t.includes('g') || t.includes('ml')).join(', ') || "5g, 10g, 20g";

const defaultVariantId = variants?.[0]?.id;
---

<a
  href={`/${countryCode}/store/${productSlug}`}
  class="group flex h-full flex-col bg-transparent w-full transition-transform duration-300 hover:-translate-y-1"
>
  <div class="relative w-full rounded-2xl overflow-hidden shadow-[0_4px_20px_-10px_rgba(0,0,0,0.05)]">
    <!-- Heart Icon -->
    <button class="absolute top-3 left-3 z-10 p-2 rounded-full bg-white/70 backdrop-blur-sm text-[#8C7355] hover:bg-white transition-colors border border-white/20 shadow-sm" aria-label="Add to favorites" onclick="event.preventDefault();">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
      </svg>
    </button>
    
    <!-- Popular Badge -->
    <div class="absolute top-3 right-3 z-10 px-2.5 py-1 rounded-md bg-[#8C7355] text-white text-[10px] font-semibold uppercase tracking-widest shadow-sm">
      Popular
    </div>
    
    <Thumbnail imageUrl={thumbnailUrl || imageUrl} title={title} priority={priority} />
  </div>

  <div class="mt-5 flex flex-col items-start gap-1">
    <div class="flex w-full justify-between items-start gap-2">
      <h3 class="text-[17px] font-medium text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-gold)] transition-colors line-clamp-2 leading-snug">
        {title}
      </h3>
    </div>
    
    <div class="text-[var(--color-accent-gold)] text-[13px] font-medium mt-0.5">
      In stock
    </div>
    
    <div class="flex items-center gap-1.5 text-[13px] mt-1 mb-2">
      <span class="text-[var(--color-text-muted)]">{sizes}</span>
    </div>
    
    <div class="w-full flex items-center justify-between pt-1">
      <div class="text-lg font-semibold text-[var(--color-text-primary)]">
        {
          cheapestPrice && (
            <Price
              priceType={cheapestPrice.price_type ?? ""}
              originalPrice={cheapestPrice.original_price}
              calculatedPrice={cheapestPrice.calculated_price}
            />
          )
        }
      </div>
      
      <button data-quick-add={defaultVariantId} class="bg-[var(--color-bg-surface-elevated)] text-[var(--color-text-primary)] p-2.5 rounded-full hover:bg-[var(--color-accent-gold)] hover:text-[var(--color-bg-primary)] transition-all duration-200 border border-[var(--color-border-subtle)] disabled:opacity-50" aria-label="Add to cart" onclick="event.preventDefault(); event.stopPropagation();">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
        </svg>
      </button>
    </div>
  </div>
</a>

<script>
  import { addToCart } from "../../../../lib/stores/cart";
  
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-quick-add]');
    buttons.forEach(btn => {
      if (btn.hasAttribute('data-init')) return;
      btn.setAttribute('data-init', 'true');
      
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        const variantId = btn.getAttribute('data-quick-add');
        if (variantId) {
          const originalHTML = btn.innerHTML;
          btn.innerHTML = '<span class="inline-block w-4 h-4 rounded-full border-2 border-current border-t-transparent animate-spin"></span>';
          btn.disabled = true;
          
          try {
            await addToCart(variantId, 1);
          } catch (error) {
            console.error("Failed to quick add", error);
          } finally {
            btn.innerHTML = originalHTML;
            btn.disabled = false;
          }
        }
      });
    });
  });
</script>
