---
import { useTranslations } from "@lib/i18n/utils";
const countryCode = Astro.params.countryCode;
const t = useTranslations(countryCode);
---

<div class="max-w-5xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
  <div class="text-center mb-12">
    <h2 class="text-3xl font-serif-heading font-bold tracking-tight text-[var(--color-text-primary)] sm:text-4xl">
      {t("store.ceremony.title")}
    </h2>
    <p class="mt-4 text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto leading-relaxed">
      {t("store.ceremony.subtitle")}
    </p>
  </div>

  <div class="grid gap-8 md:grid-cols-3">
    <div class="bg-[var(--color-card-bg)] p-8 rounded-3xl border border-[var(--color-card-border)] flex flex-col justify-between shadow-md hover:shadow-xl transition-all duration-300">
      <div>
        <div class="text-[var(--color-accent-gold)] font-mono text-sm font-bold mb-4 tracking-wider">{t("store.ceremony.step1")}</div>
        <h3 class="text-xl font-serif-heading font-bold text-[var(--color-text-primary)] mb-3">{t("store.ceremony.step1_title")}</h3>
        <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed">
          {t("store.ceremony.step1_desc")}
        </p>
      </div>
    </div>

    <div class="bg-[var(--color-card-bg)] p-8 rounded-3xl border border-[var(--color-card-border)] flex flex-col justify-between shadow-md hover:shadow-xl transition-all duration-300">
      <div>
        <div class="text-[var(--color-accent-gold)] font-mono text-sm font-bold mb-4 tracking-wider">{t("store.ceremony.step2")}</div>
        <h3 class="text-xl font-serif-heading font-bold text-[var(--color-text-primary)] mb-3">{t("store.ceremony.step2_title")}</h3>
        <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed">
          {t("store.ceremony.step2_desc")}
        </p>
      </div>
    </div>

    <div class="bg-[var(--color-card-bg)] p-8 rounded-3xl border border-[var(--color-card-border)] flex flex-col justify-between shadow-md hover:shadow-xl transition-all duration-300">
      <div>
        <div class="text-[var(--color-accent-gold)] font-mono text-sm font-bold mb-4 tracking-wider">{t("store.ceremony.step3")}</div>
        <h3 class="text-xl font-serif-heading font-bold text-[var(--color-text-primary)] mb-3">{t("store.ceremony.step3_title")}</h3>
        <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed">
          {t("store.ceremony.step3_desc")}
        </p>
      </div>
    </div>
  </div>

  <div class="mt-8 bg-[var(--color-card-bg)] border border-[var(--color-card-border)] p-6 rounded-2xl text-[var(--color-text-muted)] text-xs leading-relaxed max-w-3xl mx-auto shadow-sm">
    <span class="font-semibold text-[var(--color-accent-gold)]">{t("store.ceremony.disclaimer_title")}</span> {t("store.ceremony.disclaimer_desc")}
  </div>
</div>
