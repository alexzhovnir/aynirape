---
import { sdk } from "@lib/sdk";
import { getRegion } from "@lib/data/regions";
import { getProductPrice } from "@lib/utils/get-product-price";

interface Props {
  handle: string;
  label?: string;
}

const { handle, label } = Astro.props;

const DEFAULT_REGION = import.meta.env.DEFAULT_REGION ?? "de";

let product: any = null;
try {
  const region = await getRegion(DEFAULT_REGION);
  if (region) {
    const { products } = await sdk.store.product.list({
      handle,
      region_id: region.id,
      fields: "id,title,thumbnail,handle,*variants.calculated_price",
      limit: 1,
    });
    product = products?.[0] ?? null;
  }
} catch (e) {
  console.warn(`ProductCTA: could not load product "${handle}"`, e);
}

const href = product
  ? `/${DEFAULT_REGION}/store/${product.handle || product.id}`
  : `/${DEFAULT_REGION}/store`;

let priceLabel: string | null = null;
if (product) {
  try {
    const { cheapestPrice } = getProductPrice({ product });
    priceLabel = cheapestPrice?.calculated_price ?? null;
  } catch {
    priceLabel = null;
  }
}
---

<a
  href={href}
  class="not-prose my-6 flex items-center gap-4 rounded-2xl border border-[var(--color-border-subtle)] bg-[var(--color-bg-surface-elevated)] p-4 no-underline transition-all duration-300 hover:border-[var(--color-accent-gold)] shadow-sm hover:shadow-md"
>
  {product?.thumbnail && (
    <img
      src={product.thumbnail}
      alt={product.title}
      class="h-16 w-16 shrink-0 rounded-xl object-cover border border-[var(--color-border-subtle)] bg-[var(--color-bg-surface)]"
      loading="lazy"
    />
  )}
  <span class="flex flex-col">
    <span class="text-xs uppercase tracking-wide text-[var(--color-accent-gold)] font-bold">
      {label ?? "Featured product"}
    </span>
    <span class="font-serif-heading font-semibold text-[var(--color-text-primary)]">{product?.title ?? "Browse the shop"}</span>
    {priceLabel && <span class="text-sm font-bold text-[var(--color-accent-gold)]">{priceLabel}</span>}
  </span>
  <span class="ml-auto text-sm font-bold text-[var(--color-accent-gold)]">Shop →</span>
</a>
